-- Light ongoing watchdog: if GUI disappears later, try one recovery cycle.
task.spawn(function()
    task.wait(12)
    local misses = 0
    while true do
        task.wait(8)
        local ok, present = pcall(ScriptRecovery.isGuiPresent)
        if ok and present then
            misses = 0
            pcall(scriptRecoveryResetGuiReloads)
        else
            misses = misses + 1
            if misses >= 2 then
                misses = 0
                warn("[Methion] GUI disappeared while script was running — attempting reload.")
                ScriptRecovery.ensureGuiOrReload({
                    Wait = 1.5,
                    Reason = "Methion GUI disappeared at runtime",
                    MaxAttempts = ScriptRecovery.MaxGuiReloads,
                })
            end
        end
    end
end)
