function PlayerTarget.normalize(name)
    return string.lower((tostring(name or ""):gsub("%s+", " ")):match("^%s*(.-)%s*$") or "")
end

function PlayerTarget.standName(plr)
    if not plr then return "None" end
    local _, stand = Utils.playerInfo(plr)
    stand = tostring(stand or "None")
    if stand == "" or stand == "?" then stand = "None" end
    return stand
end

function PlayerTarget.hasStand(stand)
    local n = PlayerTarget.normalize(stand)
    return n ~= "" and n ~= "none" and n ~= "?" and n ~= "nil"
end

function PlayerTarget.isVillainStand(stand)
    if not PlayerTarget.hasStand(stand) then return false end
    local exact = PlayerTarget.normalize(stand)
    for _, name in ipairs(PlayerTarget.VillainStands) do
        if PlayerTarget.normalize(name) == exact then
            return true
        end
    end
    for _, key in ipairs(PlayerTarget.VillainKeywords) do
        if exact:find(key, 1, true) then
            return true
        end
    end
    return false
end

function PlayerTarget.matches(plr)
    if not plr or plr == LP or not plr.Parent then return false end
    local stand = PlayerTarget.standName(plr)
    local mode = PlayerTarget.Mode
    if mode == "Villain" then
        return PlayerTarget.isVillainStand(stand)
    elseif mode == "AnyStand" then
        return PlayerTarget.hasStand(stand)
    elseif mode == "NoStand" then
        return not PlayerTarget.hasStand(stand)
    end
    return true -- All
end

function PlayerTarget.isAlive(plr)
    local char = plr and plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    return hum and hum.Health > 0 and root ~= nil
end

function PlayerTarget.list(aliveOnly)
    local out = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if PlayerTarget.matches(plr) and (not aliveOnly or PlayerTarget.isAlive(plr)) then
            table.insert(out, plr)
        end
    end
    table.sort(out, function(a, b)
        return string.lower(a.Name) < string.lower(b.Name)
    end)
    return out
end

function PlayerTarget.describe(plr)
    if not plr then return "None" end
    local stand = PlayerTarget.standName(plr)
    local tag = PlayerTarget.isVillainStand(stand) and " [VILLAIN]" or ""
    return string.format("%s (@%s) — %s%s", tostring(plr.DisplayName or plr.Name), plr.Name, stand, tag)
end

