_G.__MethionSettingsSections.Persist:Button({
    Title = "Clear Auto-Start Config",
    Desc = "Turn off auto-start flags and save (features stay on for this session only).",
    Icon = "trash-2",
    Callback = function()
        -- Snapshot current runtime, force AutoStart all false in file without stopping this session.
        local snap = SettingsStore.snapshot()
        if type(snap) == "table" then
            snap.AutoStart = {
                Farm = false,
                StandFarm = false,
                AutoBuyLucky = false,
                ItemEsp = State.ItemEsp == true,
                PlayerEsp = State.PlayerEsp == true,
                ItemTracker = State.ItemTracker == true,
                PlayerTracker = State.PlayerTracker == true,
                NotifyItemSpawn = State.NotifyItemSpawn == true,
                NoClip = false,
                WalkSpeed = false,
                JumpPower = false,
                LowGraphics = false,
                AutoRejoin = Config.AutoRejoinEnabled == true,
            }
            snap.State = snap.State or {}
            snap.State.Farm = false
            snap.State.StandFarm = false
        end

        local okEncode, payload = pcall(function()
            return HttpService:JSONEncode(snap)
        end)
        local saved = false
        if okEncode and type(payload) == "string" then
            local writeFn = writefile or (type(syn) == "table" and syn.write_file) or nil
            if type(writeFn) == "function" then
                saved = pcall(writeFn, SettingsStore.FileName, payload)
            end
            MethionSH_Env.__MethionSHSavedSettings = payload
            saved = saved or true
        end

        if saved then
            pcall(function()
                Window:Notify({
                    Title = "Auto-Start cleared",
                    Content = "Next launch will not auto-start Farm / Stand Farm. Current session is unchanged.",
                    Type = "Info",
                    Duration = 5,
                })
            end)
            refreshAutoStartStatus()
        else
            pcall(function()
                Window:Notify({
                    Title = "Clear failed",
                    Content = "Could not write settings file.",
                    Type = "Warning",
                    Duration = 4,
                })
            end)
        end
    end,
})

