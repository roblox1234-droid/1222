function PlayerTarget.selectNearest()
    local character = LP.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local nearest, nearestDistance = nil, math.huge
    for _, plr in ipairs(PlayerTarget.list(true)) do
        local targetRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local distance = (targetRoot.Position - root.Position).Magnitude
            if distance < nearestDistance then
                nearest, nearestDistance = plr, distance
            end
        end
    end
    if nearest then
        PlayerTarget.select(nearest)
    end
    return nearest, nearestDistance
end

function PlayerTarget.cycle(direction)
    direction = direction == -1 and -1 or 1
    local list = PlayerTarget.list(true)
    if #list == 0 then
        PlayerTarget.refreshStatus()
        return nil
    end
    PlayerTarget.CycleIndex = PlayerTarget.CycleIndex + direction
    if PlayerTarget.CycleIndex < 1 then PlayerTarget.CycleIndex = #list end
    if PlayerTarget.CycleIndex > #list then PlayerTarget.CycleIndex = 1 end
    local plr = list[PlayerTarget.CycleIndex]
    PlayerTarget.select(plr)
    return plr
end

function PlayerTarget.clearHighlights()
    for plr, hl in pairs(PlayerTarget.Highlights) do
        pcall(function()
            if hl and hl.Parent then hl:Destroy() end
        end)
        PlayerTarget.Highlights[plr] = nil
    end
end

function PlayerTarget.applyEsp()
    if not PlayerTarget.ShowEsp then
        PlayerTarget.clearHighlights()
        return
    end
    local active = {}
    for _, plr in ipairs(PlayerTarget.list(true)) do
        active[plr] = true
        local char = plr.Character
        if char then
            local hl = PlayerTarget.Highlights[plr]
            if not hl or not hl.Parent then
                hl = Instance.new("Highlight")
                hl.Name = "Methion_PlayerTargetHL"
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.FillTransparency = 0.55
                hl.OutlineTransparency = 0
                hl.Parent = char
                PlayerTarget.Highlights[plr] = hl
            end
            hl.Adornee = char
            local stand = PlayerTarget.standName(plr)
            if PlayerTarget.isVillainStand(stand) then
                hl.FillColor = Color3.fromRGB(220, 40, 40)
                hl.OutlineColor = Color3.fromRGB(255, 120, 120)
            else
                hl.FillColor = Color3.fromRGB(80, 160, 255)
                hl.OutlineColor = Color3.fromRGB(200, 230, 255)
            end
            hl.Enabled = true
        end
    end
    for plr, hl in pairs(PlayerTarget.Highlights) do
        if not active[plr] then
            pcall(function()
                if hl and hl.Parent then hl:Destroy() end
            end)
            PlayerTarget.Highlights[plr] = nil
        end
    end
end

function PlayerTarget.setMode(mode)
    if mode == "Villain stands" or mode == "Villain" then
        PlayerTarget.Mode = "Villain"
    elseif mode == "Any stand" or mode == "AnyStand" then
        PlayerTarget.Mode = "AnyStand"
    elseif mode == "No stand" or mode == "NoStand" then
        PlayerTarget.Mode = "NoStand"
    else
        PlayerTarget.Mode = "All"
    end
    PlayerTarget.CycleIndex = 0
    PlayerTarget.refreshStatus()
    PlayerTarget.applyEsp()
    if PlayerTarget.AutoSelect then
        PlayerTarget.autoSelectTick(true)
    end
end

function PlayerTarget.currentIsValid()
    local plr = State.SelectedPlayer
    if not plr or not plr.Parent or plr == LP then return false end
    if not PlayerTarget.matches(plr) then return false end
    if not PlayerTarget.isAlive(plr) then return false end
    return true
end

function PlayerTarget.autoSelectTick(force)
    if not PlayerTarget.AutoSelect and not force then return false end
    local now = tick()
    if not force and now - (PlayerTarget.LastAutoSelectAt or 0) < (PlayerTarget.AutoSelectInterval or 0.75) then
        return false
    end

    -- Keep current target if still valid
    if PlayerTarget.RetargetIfInvalid ~= false and PlayerTarget.currentIsValid() and not force then
        if PlayerTarget.AutoAttach and PlayerTarget.AttachedTo ~= State.SelectedPlayer then
            PlayerTarget.engageTarget(State.SelectedPlayer, false)
        end
        return false
    end

    local target, distance
    if PlayerTarget.PreferNearest ~= false then
        target, distance = PlayerTarget.selectNearest()
    else
        local list = PlayerTarget.list(true)
        if #list > 0 then
            PlayerTarget.CycleIndex = (PlayerTarget.CycleIndex % #list) + 1
            target = list[PlayerTarget.CycleIndex]
            PlayerTarget.select(target)
        end
    end

    PlayerTarget.LastAutoSelectAt = now
    if target then
        if PlayerTarget.AutoAttach then
            PlayerTarget.engageTarget(target, true)
        end
        return true
    end
    return false
end

function PlayerTarget.stopAttach()
    if PlayerTarget.AttachConn then
        pcall(function() PlayerTarget.AttachConn:Disconnect() end)
        PlayerTarget.AttachConn = nil
    end
    PlayerTarget.AttachedTo = nil
end

function PlayerTarget.getPilotApi()
    local pilot = _G.MethionStandPilotRuntime
    if type(pilot) ~= "table" then return nil end
    return pilot
end

function PlayerTarget.ensurePilot(enabled)
    local pilot = PlayerTarget.getPilotApi()
    if not pilot then return false end
    if enabled then
        if pilot.Enabled then return true end
        if type(pilot.SetEnabled) == "function" then
            local ok = pcall(function() pilot.SetEnabled(true) end)
            task.wait(0.15)
            return ok and pilot.Enabled == true
        end
    else
        if type(pilot.Stop) == "function" then
            pcall(function() pilot.Stop() end)
        elseif type(pilot.Cleanup) == "function" then
            pcall(function() pilot.Cleanup() end)
        end
        return true
    end
    return false
end

function PlayerTarget.forceNoclip(character)
    character = character or LP.Character
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.CanCollide = false
            end)
        end
    end
    local stand = character:FindFirstChild("StandMorph")
    if stand then
        for _, part in ipairs(stand:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = false
                end)
            end
        end
    end
end

function PlayerTarget.goalCFrame(plr)
    if not plr or not plr.Character then return nil end
    local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return nil end
    local offset = PlayerTarget.AttachOffset or Vector3.new(0, 0.35, 0.35)
    -- Keep offset relative to target facing so we stay "behind/above"
    local worldOffset = targetRoot.CFrame:VectorToWorldSpace(offset)
    local pos = targetRoot.Position + worldOffset
    return CFrame.lookAt(pos, targetRoot.Position)
end

function PlayerTarget.teleportToPlayer(plr)
    local goal = PlayerTarget.goalCFrame(plr)
    if not goal then return false end
    State.NoClip = true
    PlayerTarget.forceNoclip()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    -- Prefer visible flight toward the target; fall back to hard set.
    local ok = false
    if Move and type(Move.flyCF) == "function" then
        local speed = math.clamp(tonumber(Config.TweenSpeed) or 300, 10, 3000)
        ok = Move.flyCF(goal, speed, function()
            return PlayerTarget.AutoAttach == true
                and plr.Parent ~= nil
                and PlayerTarget.isAlive(plr)
        end) == true
    end
    if not ok then
        root.CFrame = goal
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        ok = true
    end
    State.NoClip = true
    return ok
end

function PlayerTarget.stickFrame(plr, dt)
    if not plr or not plr.Parent or not plr.Character then return false end
    local targetRoot = plr.Character:FindFirstChild("HumanoidRootPart")
    local targetHum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not targetHum or targetHum.Health <= 0 then return false end

    local character = LP.Character
    if not character then return false end
    local myRoot = character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end

    local goal = PlayerTarget.goalCFrame(plr)
    if not goal then return false end

    local stand = character:FindFirstChild("StandMorph")
    local standRoot = stand and (stand.PrimaryPart or stand:FindFirstChild("HumanoidRootPart"))
    local pilot = PlayerTarget.getPilotApi()
    local pilotOn = pilot and pilot.Enabled == true

    State.NoClip = true
    PlayerTarget.forceNoclip(character)

    dt = tonumber(dt) or 0.016
    local dist = (myRoot.Position - goal.Position).Magnitude
    -- Smooth fly-in when far, hard lock when close
    local alpha
    if dist > 80 then
        alpha = math.clamp((PlayerTarget.FlySpeed or 320) * dt / dist, 0.08, 0.45)
    elseif dist > 18 then
        alpha = math.clamp((PlayerTarget.FlySpeed or 320) * dt / dist, 0.15, 0.7)
    else
        alpha = 1
    end

    local bodyGoal = goal
    if pilotOn then
        -- Body stays under the stand while piloting
        bodyGoal = goal - Vector3.new(0, 35, 0)
    end

    local nextBody = myRoot.CFrame:Lerp(bodyGoal, alpha)
    myRoot.CFrame = nextBody
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    pcall(function()
        myRoot.Velocity = Vector3.zero
        myRoot.RotVelocity = Vector3.zero
    end)

    if standRoot and standRoot.Parent then
        local standGoal = goal
        local nextStand = standRoot.CFrame:Lerp(standGoal, math.max(alpha, 0.35))
        standRoot.CFrame = nextStand
        standRoot.AssemblyLinearVelocity = Vector3.zero
        standRoot.AssemblyAngularVelocity = Vector3.zero
        pcall(function()
            if stand.PrimaryPart then
                stand:PivotTo(nextStand)
            end
        end)
    end

    -- Keep humanoid from falling / ragdoll fighting the stick
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function()
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
    return true
end

function PlayerTarget.startAttachLoop(plr)
    PlayerTarget.stopAttach()
    if not plr then return false end
    PlayerTarget.AttachedTo = plr
    PlayerTarget.FlySpeed = math.clamp(tonumber(Config.TweenSpeed) or 300, 10, 3000)
    State.NoClip = true
    PlayerTarget.forceNoclip()

    PlayerTarget.AttachConn = RunService.Heartbeat:Connect(function(dt)
        if not PlayerTarget.AutoAttach then
            PlayerTarget.stopAttach()
            return
        end
        local target = PlayerTarget.AttachedTo
        if not target or not target.Parent or not PlayerTarget.isAlive(target) then
            PlayerTarget.stopAttach()
            if PlayerTarget.AutoSelect then
                task.defer(function() PlayerTarget.autoSelectTick(true) end)
            end
            return
        end
        -- Keep chasing even if filter text flickers; only drop when dead/left.
        if not PlayerTarget.stickFrame(target, dt) then
            PlayerTarget.stopAttach()
            if PlayerTarget.AutoSelect then
                task.defer(function() PlayerTarget.autoSelectTick(true) end)
            end
        end
    end)
    return true
end

function PlayerTarget.engageTarget(plr, forceTeleport)
    if not plr or not plr.Parent then return false end
    local now = tick()
    if not forceTeleport and now - (PlayerTarget.LastEngageAt or 0) < (PlayerTarget.EngageCooldown or 0.8) then
        if PlayerTarget.AttachedTo ~= plr then
            PlayerTarget.startAttachLoop(plr)
        end
        return true
    end
    PlayerTarget.LastEngageAt = now
    PlayerTarget.select(plr)
    PlayerTarget.AutoAttach = true
    State.NoClip = true
    PlayerTarget.forceNoclip()

    -- Start stick immediately so we begin flying toward them right away
    PlayerTarget.startAttachLoop(plr)

    task.spawn(function()
        if PlayerTarget.AutoTeleport ~= false or forceTeleport then
            -- Hard pull closer first, then keep flying via stick loop
            pcall(function()
                local goal = PlayerTarget.goalCFrame(plr)
                local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if goal and root then
                    local dist = (root.Position - goal.Position).Magnitude
                    if dist > 25 and Move and type(Move.flyCF) == "function" then
                        Move.flyCF(goal, math.clamp(tonumber(Config.TweenSpeed) or 300, 10, 3000), function()
                            return PlayerTarget.AutoAttach and PlayerTarget.AttachedTo == plr and PlayerTarget.isAlive(plr)
                        end)
                    elseif goal and root then
                        root.CFrame = goal
                        root.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end)
        end

        if PlayerTarget.AutoPilot ~= false then
            pcall(function() PlayerTarget.ensurePilot(true) end)
        end

        -- Re-assert attach after pilot init (pilot can move body)
        if PlayerTarget.AutoAttach and plr.Parent then
            PlayerTarget.startAttachLoop(plr)
        end
    end)

    return true
end

