function SettingsStore.apply(data)
    if type(data) ~= "table" then return false end
    local cfg = data.Config
    local st = data.State
    local auto = data.AutoStart
    if type(cfg) == "table" then
        if cfg.TweenSpeed ~= nil then Config.TweenSpeed = tonumber(cfg.TweenSpeed) or Config.TweenSpeed end
        if cfg.AutoBuyLucky ~= nil then Config.AutoBuyLucky = cfg.AutoBuyLucky == true end
        if cfg.AutoRedeemLucky ~= nil then Config.AutoRedeemLucky = cfg.AutoRedeemLucky == true end
        if cfg.LuckyArrowMaxStock ~= nil then
            Config.LuckyArrowMaxStock = math.clamp(math.floor(tonumber(cfg.LuckyArrowMaxStock) or Config.LuckyArrowMaxStock or 9), 1, 9)
        end
        if type(cfg.FarmOnlyItems) == "table" then Config.FarmOnlyItems = cfg.FarmOnlyItems end
        if cfg.FarmOtherItems ~= nil then Config.FarmOtherItems = cfg.FarmOtherItems == true end
        if cfg.AutoRejoinEnabled ~= nil then Config.AutoRejoinEnabled = cfg.AutoRejoinEnabled == true end
        if cfg.FarmTeleportMode == "instant" or cfg.FarmTeleportMode == "tween" then
            Config.FarmTeleportMode = cfg.FarmTeleportMode
        end
        if cfg.InstantDelay ~= nil then Config.InstantDelay = tonumber(cfg.InstantDelay) or Config.InstantDelay end
        if cfg.InstantCooldown ~= nil then Config.InstantCooldown = tonumber(cfg.InstantCooldown) or 0 end
        if cfg.NotifyItemSpawn ~= nil then Config.NotifyItemSpawn = cfg.NotifyItemSpawn == true end
        if type(cfg.Esp) == "table" then
            local esp = settingsStoreDeepCopy(cfg.Esp, "unpack")
            for k, v in pairs(esp) do Config.Esp[k] = v end
        end
        if type(cfg.Teleport) == "table" then
            if cfg.Teleport.Mode ~= nil then Config.Teleport.Mode = cfg.Teleport.Mode end
            if cfg.Teleport.SelectedLocation ~= nil then Config.Teleport.SelectedLocation = cfg.Teleport.SelectedLocation end
        end
        if type(cfg.Player) == "table" then
            for k, v in pairs(cfg.Player) do
                if Config.Player[k] ~= nil then Config.Player[k] = v end
            end
        end
    end
    if type(st) == "table" then
        local keys = {
            "Farm", "StandFarm",
            "ItemEsp", "NotifyItemSpawn", "PlayerEsp", "ItemTracker", "PlayerTracker", "LowGraphics",
            "AutoDialogueOneClick",
            "StandFarmSelected", "StandFarmLearnWorthiness", "StandFarmWorthinessLevel",
            "StandFarmAutoRequiem", "StandFarmAutoBuy", "StandFarmWatchdog", "StandFarmAutoCollect",
            "StandFarmRestockAmount", "StandFarmSkinsSelected", "StandFarmSkinsCustom", "StandFarmKeepEvolved",
            "StandFarmWanted", "StandFarmLoopDelay",
        }
        for _, key in ipairs(keys) do
            if st[key] ~= nil then State[key] = st[key] end
        end
    end
    -- Prefer explicit AutoStart block when present (version 3+)
    if type(auto) == "table" then
        if auto.Farm ~= nil then State.Farm = auto.Farm == true end
        if auto.StandFarm ~= nil then State.StandFarm = auto.StandFarm == true end
        if auto.AutoBuyLucky ~= nil then Config.AutoBuyLucky = auto.AutoBuyLucky == true end
        if auto.AutoRedeemLucky ~= nil then Config.AutoRedeemLucky = auto.AutoRedeemLucky == true end
        if auto.ItemEsp ~= nil then State.ItemEsp = auto.ItemEsp == true end
        if auto.PlayerEsp ~= nil then State.PlayerEsp = auto.PlayerEsp == true end
        if auto.ItemTracker ~= nil then State.ItemTracker = auto.ItemTracker == true end
        if auto.PlayerTracker ~= nil then State.PlayerTracker = auto.PlayerTracker == true end
        if auto.NotifyItemSpawn ~= nil then
            State.NotifyItemSpawn = auto.NotifyItemSpawn == true
            Config.NotifyItemSpawn = State.NotifyItemSpawn
        end
        if auto.NoClip ~= nil then Config.Player.NoClipEnabled = auto.NoClip == true end
        if auto.WalkSpeed ~= nil then Config.Player.WalkSpeedEnabled = auto.WalkSpeed == true end
        if auto.JumpPower ~= nil then Config.Player.JumpPowerEnabled = auto.JumpPower == true end
        if auto.LowGraphics ~= nil then State.LowGraphics = auto.LowGraphics == true end
        if auto.AutoRejoin ~= nil then Config.AutoRejoinEnabled = auto.AutoRejoin == true end
    end
    SettingsStore._loaded = true
    SettingsStore._pendingRestore = true
    return true
end

-- Apply saved feature toggles AFTER the UI and systems exist.
function SettingsStore.restoreRuntime(refs)
    refs = type(refs) == "table" and refs or {}
    if not SettingsStore._pendingRestore and not MAIN_AUTOSTART then
        return false
    end
    SettingsStore._pendingRestore = false

    local started = {}

    local function trySetToggle(toggle, value)
        if not toggle then return false end
        value = value == true
        for _, methodName in ipairs({"Set", "SetValue", "SetState"}) do
            local ok, method = pcall(function() return toggle[methodName] end)
            if ok and type(method) == "function" then
                local applied = pcall(function() method(toggle, value, true) end)
                if not applied then
                    applied = pcall(function() method(toggle, value) end)
                end
                if applied then return true end
            end
        end
        return false
    end

    -- ESP / trackers (safe, always apply)
    pcall(function()
        if State.ItemEsp then
            ItemESP.scan()
            ItemESP.setVisible(true)
            table.insert(started, "Item ESP")
        else
            ItemESP.setVisible(false)
        end
    end)
    pcall(function()
        if State.PlayerEsp then
            PlayerESP.refresh()
            table.insert(started, "Player ESP")
        end
    end)

    -- Auto Farm
    local wantFarm = (State.Farm == true) or (MAIN_AUTOSTART == true)
    if wantFarm then
        local setOk = trySetToggle(refs.AutoFarmToggle or AutoFarmToggle, true)
        if not setOk then
            State.Farm = true
            State.NoClip = true
            pcall(function() ItemESP.scan() end)
        end
        table.insert(started, "Auto Farm")
    end

    -- Stand Farm
    if State.StandFarm == true then
        local setOk = trySetToggle(refs.StandFarmToggle, true)
        if not setOk then
            pcall(function()
                if StandFarm and type(StandFarm.start) == "function" then
                    StandFarm.start()
                end
            end)
        end
        table.insert(started, "Stand Farm")
    end

    -- Auto buy / redeem lucky arrows
    if Config.AutoBuyLucky == true or Config.AutoRedeemLucky == true then
        trySetToggle(refs.AutoBuyLuckyToggle, Config.AutoBuyLucky == true)
        pcall(function()
            if Shop and type(Shop.autoLucky) == "function" then
                Shop.autoLucky()
            end
        end)
        if Config.AutoBuyLucky == true then table.insert(started, "Auto Buy Lucky") end
        if Config.AutoRedeemLucky == true then table.insert(started, "Auto Redeem Lucky") end
    end

    -- Movement helpers
    pcall(function()
        if Config.Player.NoClipEnabled and Player and type(Player.noclip) == "function" then
            Player.noclip()
            table.insert(started, "No-Clip")
        end
    end)
    pcall(function()
        if Config.Player.WalkSpeedEnabled and _G.MethionMovementState then
            _G.MethionMovementState.wsEnabled = true
            _G.MethionMovementState.wsSpeed = tonumber(Config.Player.WalkSpeed) or 24
        end
        if Config.Player.JumpPowerEnabled and _G.MethionMovementState then
            _G.MethionMovementState.jpEnabled = true
            _G.MethionMovementState.jpPower = tonumber(Config.Player.JumpPower) or 24
        end
    end)

    -- Low graphics
    pcall(function()
        if State.LowGraphics and LowGfx and type(LowGfx.apply) == "function" then
            LowGfx.apply()
            table.insert(started, "Low Graphics")
        end
    end)

    -- Rejoin watcher
    pcall(function()
        if Config.AutoRejoinEnabled and Rejoin and type(Rejoin.start) == "function" then
            Rejoin.start()
        end
    end)

    if #started > 0 then
        pcall(function()
            AirflowCompat:Notify({
                Title = "Config restored",
                Content = "Auto-started: " .. table.concat(started, ", "),
                Type = "Success",
                Duration = 5,
            })
        end)
        print("[METHION] Restored saved features: " .. table.concat(started, ", "))
    end
    return true
end

function SettingsStore.save(force)
    if not force and not SettingsStore.AutoSave then return false end
    local now = tick()
    if not force and now - SettingsStore.LastSave < SettingsStore.SaveCooldown then return false end
    SettingsStore.LastSave = now

    local okEncode, payload = pcall(function()
        return HttpService:JSONEncode(SettingsStore.snapshot())
    end)
    if not okEncode or type(payload) ~= "string" then return false end

    local writeFn = writefile or (type(syn) == "table" and syn.write_file) or nil
    if type(writeFn) ~= "function" then
        -- Fallback: keep in getgenv for this executor session / rejoin via queue
        MethionSH_Env.__MethionSHSavedSettings = payload
        return true
    end
    local okWrite = pcall(writeFn, SettingsStore.FileName, payload)
    if okWrite then
        MethionSH_Env.__MethionSHSavedSettings = payload
    end
    return okWrite == true
end

function SettingsStore.load()
    local raw = nil
    local readFn = readfile or (type(syn) == "table" and syn.read_file) or nil
    if type(readFn) == "function" then
        local ok, content = pcall(readFn, SettingsStore.FileName)
        if ok and type(content) == "string" and #content > 2 then
            raw = content
        end
    end
    if not raw and type(MethionSH_Env.__MethionSHSavedSettings) == "string" then
        raw = MethionSH_Env.__MethionSHSavedSettings
    end
    if type(raw) ~= "string" then return false end

    local okDecode, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not okDecode or type(data) ~= "table" then return false end
    return SettingsStore.apply(data)
end

function SettingsStore.markDirty()
    if not SettingsStore.AutoSave then return end
    task.defer(function()
        SettingsStore.save(false)
    end)
end

