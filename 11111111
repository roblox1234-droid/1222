-- Full Anasui quest (start → finish): talk → objectives → return → done
function Heaven.runAnasuiQuest()
    Heaven.setStatus("Anasui Quest: looking for Anasui...")
    local started = tick()
    local lastTalk = 0
    local lastQuest = ""
    local stagnantSince = tick()
    local talkCount = 0
    local killsThisCycle = 0

    -- Initial dialogue (start quest)
    if not Heaven.talkNpc({"anasui", "narciso"}, "Anasui", "Option1") then
        Heaven.setStatus("Anasui not found / dialogue failed. Stand near him and retry.")
        heavenNotify("Anasui quest: could not start dialogue.", "Warning", 6)
        return false
    end
    talkCount = 1
    lastTalk = tick()
    lastQuest = Heaven.currentQuestText()
    heavenNotify("Anasui quest started.", "Success", 4)

    while Heaven.Active and tick() - started < 1500 do
        -- Done early if Diver Down somehow obtained mid-quest
        if Heaven.hasDiverDown() then
            Heaven.setStatus("Anasui Quest: complete (Diver Down equipped).")
            heavenNotify("Anasui quest finished!", "Success", 7)
            return true
        end

        local quest = Heaven.currentQuestText()
        local qLower = string.lower(quest)

        -- Quest finished / turn-in wording
        local needsTurnIn = quest == "" or quest == "--"
            or string.find(qLower, "talk", 1, true)
            or string.find(qLower, "return", 1, true)
            or string.find(qLower, "anasui", 1, true)
            or string.find(qLower, "report", 1, true)
            or string.find(qLower, "complete", 1, true)
            or string.find(qLower, "finish", 1, true)
            or string.find(qLower, "done", 1, true)

        if needsTurnIn or tick() - lastTalk > 50 or killsThisCycle >= 12 then
            Heaven.setStatus("Anasui Quest: talking to Anasui again...")
            local okTalk = Heaven.talkNpc({"anasui", "narciso"}, "Anasui", "Option1")
            lastTalk = tick()
            talkCount += 1
            killsThisCycle = 0
            task.wait(0.5)

            local newQuest = Heaven.currentQuestText()
            if okTalk then
                -- If quest cleared after several turn-ins, treat as done
                if (newQuest == "" or newQuest == "--") and talkCount >= 2 then
                    Heaven.setStatus("Anasui Quest: finished (no active quest left).")
                    heavenNotify("Anasui quest complete!", "Success", 7)
                    return true
                end
                if newQuest ~= lastQuest and lastQuest ~= "" then
                    Heaven.setStatus("Anasui Quest: next objective — " .. newQuest)
                    lastQuest = newQuest
                    stagnantSince = tick()
                elseif tick() - stagnantSince > 180 and talkCount >= 3 then
                    -- Progress stalled after multiple talks — consider finished
                    Heaven.setStatus("Anasui Quest: done (no further objectives detected).")
                    heavenNotify("Anasui quest finished.", "Success", 6)
                    return true
                end
            end
        end

        quest = Heaven.currentQuestText()
        if quest ~= lastQuest then
            lastQuest = quest
            stagnantSince = tick()
        end

        local labels = Heaven.ddQuestNpcLabels()
        Heaven.setStatus(string.format(
            "Anasui Quest: [%s] — farming %s",
            (quest ~= "" and quest ~= "--") and quest or "waiting",
            table.concat(labels, "/")
        ))

        local enemy = Heaven.findNpc(labels)
        if enemy then
            Heaven.kill(enemy)
            killsThisCycle += 1
            task.wait(0.12)
        else
            local mk = Config.Teleport.Locations["Merchant's Keep"]
                or Vector3.new(-620.4, -25.8, -465.1)
            if tick() % 12 < 0.2 then
                pcall(function()
                    Move.goToCF(CFrame.new(mk + Vector3.new(math.random(-35, 35), 3, math.random(-35, 35))), Config.Teleport.Mode)
                end)
            end
            task.wait(0.55)
        end

        local gui = Gui.currentDialogue()
        if gui then
            pcall(function()
                Gui.oneClick()
                task.wait(0.2)
                Gui.advanceUntilClosed(4)
            end)
        end
    end

    -- Final turn-in attempt
    pcall(function() Heaven.talkNpc({"anasui", "narciso"}, "Anasui", "Option1") end)
    Heaven.setStatus("Anasui Quest ended. Check quest status if not finished.")
    heavenNotify("Anasui quest loop ended. Verify completion in-game.", "Info", 6)
    return true
end

function Heaven.ddJotaro()
    if Heaven.hasDiverDown() then return true end
    Heaven.setStatus("DD 4/6: Talking to Friendly Jotaro...")
    return Heaven.talkNpc({"friendly jotaro", "jotaro"}, "Friendly Jotaro", "Option1")
end

function Heaven.ddQuestNpcLabels()
    -- Map quest text keywords → NPC labels to farm
    local text = string.lower(Heaven.currentQuestText())
    local pairsList = {
        {keys = {"thug", "street"}, labels = {"Thug"}},
        {keys = {"alpha"}, labels = {"Alpha Thug"}},
        {keys = {"police", "corrupt"}, labels = {"Corrupt Police"}},
        {keys = {"zombie", "henchman"}, labels = {"Zombie Henchman"}},
        {keys = {"vampire"}, labels = {"Vampire"}},
        {keys = {"security"}, labels = {"Security Guard", "Security"}},
        {keys = {"tourist"}, labels = {"Tourist"}},
    }
    local out = {}
    for _, entry in ipairs(pairsList) do
        for _, key in ipairs(entry.keys) do
            if string.find(text, key, 1, true) then
                for _, label in ipairs(entry.labels) do
                    table.insert(out, label)
                end
                break
            end
        end
    end
    if #out == 0 then
        -- Default progression farm while quest is active
        out = {"Thug", "Alpha Thug", "Corrupt Police", "Zombie Henchman", "Vampire"}
    end
    return out
end

function Heaven.ddCompleteObjectives()
    if Heaven.hasDiverDown() then return true end
    Heaven.setStatus("DD 5/6: Completing Jotaro quest objectives...")
    local started = tick()
    local lastTalk = 0
    local idleSince = tick()

    while Heaven.Active and tick() - started < 1200 do
        if Heaven.hasDiverDown() then
            Heaven.setStatus("DD 5/6: Diver Down obtained during objectives!")
            return true
        end

        local quest = Heaven.currentQuestText()
        local questLower = string.lower(quest)

        -- Re-talk Jotaro periodically / when quest looks empty or finished wording
        if tick() - lastTalk > 45
            or quest == ""
            or quest == "--"
            or string.find(questLower, "talk", 1, true)
            or string.find(questLower, "return", 1, true)
            or string.find(questLower, "jotaro", 1, true)
            or string.find(questLower, "complete", 1, true)
            or string.find(questLower, "report", 1, true) then
            lastTalk = tick()
            Heaven.setStatus("DD 5/6: Checking in with Friendly Jotaro...")
            pcall(function() Heaven.ddJotaro() end)
            task.wait(0.6)
            if Heaven.hasDiverDown() then return true end
        end

        local labels = Heaven.ddQuestNpcLabels()
        Heaven.setStatus(string.format(
            "DD 5/6: Quest [%s] — farming %s",
            (quest ~= "" and quest ~= "--") and quest or "unknown",
            table.concat(labels, "/ ")
        ))

        local enemy = Heaven.findNpc(labels)
        if enemy then
            idleSince = tick()
            Heaven.kill(enemy)
            task.wait(0.15)
        else
            -- Wander / wait for spawns near common areas
            if tick() - idleSince > 20 then
                idleSince = tick()
                local mk = Config.Teleport.Locations["Merchant's Keep"]
                    or Vector3.new(-620.4, -25.8, -465.1)
                pcall(function()
                    Move.goToCF(CFrame.new(mk + Vector3.new(math.random(-30, 30), 3, math.random(-30, 30))), Config.Teleport.Mode)
                end)
            end
            task.wait(0.6)
        end

        -- Click through any open dialogue that appears mid-quest
        local gui = Gui.currentDialogue()
        if gui then
            pcall(function()
                Gui.oneClick()
                task.wait(0.2)
                Gui.advanceUntilClosed(4)
            end)
        end
    end

    -- Final talk attempt
    pcall(function() Heaven.ddJotaro() end)
    pcall(function() Heaven.ddAnasui() end)
    pcall(function() Heaven.ddPucci() end)
    return Heaven.hasDiverDown()
end

function Heaven.ddConfirmFinish()
    if Heaven.hasDiverDown() then
        Heaven.setStatus("DD 6/6: Done — Diver Down equipped.")
        heavenNotify("Diver Down quest finished!", "Success", 8)
        return true
    end
    -- Last resort: talk NPCs again then check
    Heaven.setStatus("DD 6/6: Final NPC check...")
    pcall(function() Heaven.ddJotaro() end)
    task.wait(0.5)
    pcall(function() Heaven.ddAnasui() end)
    task.wait(0.5)
    if Heaven.hasDiverDown() then
        Heaven.setStatus("DD 6/6: Done — Diver Down equipped.")
        heavenNotify("Diver Down quest finished!", "Success", 8)
        return true
    end
    Heaven.setStatus("DD chain ended. Stand is still: " .. Heaven.standName() .. " (check quest manually if needed).")
    heavenNotify("DD chain finished, but Diver Down not detected yet. Check your quest.", "Warning", 7)
    return Heaven.hasDiverDown()
end

function Heaven.runDD(mode)
    local steps = {
        DD_StoneFree = {Heaven.ddStoneFree},
        DD_Pucci = {Heaven.ddPucci},
        DD_Anasui = {Heaven.ddAnasui},
        DD_Jotaro = {Heaven.ddJotaro},
        DD_Objectives = {Heaven.ddCompleteObjectives},
        DDChain = {
            Heaven.ddStoneFree,
            Heaven.ddPucci,
            Heaven.ddAnasui,
            Heaven.ddJotaro,
            Heaven.ddCompleteObjectives,
            Heaven.ddConfirmFinish,
        },
    }
    for _, fn in ipairs(steps[mode] or {}) do
        if not Heaven.Active then return end
        if Heaven.hasDiverDown() and mode == "DDChain" then
            Heaven.setStatus("Already have Diver Down — DD chain complete.")
            heavenNotify("Already have Diver Down.", "Success", 5)
            return
        end
        if not fn() then
            heavenNotify("DD chain stopped at: " .. tostring(mode), "Warning", 5)
            return
        end
        task.wait(0.5)
    end
    if mode == "DDChain" then
        if Heaven.hasDiverDown() then
            Heaven.setStatus("DD full chain complete — Diver Down ready.")
            heavenNotify("DD quest complete from start to finish!", "Success", 8)
        else
            Heaven.setStatus("DD chain steps done. Finish any remaining manual objective if stand is not Diver Down yet.")
        end
    end
end

function Heaven.start(mode)
    if Heaven.Active then return end
    Heaven.Active = true
    Heaven.Mode = mode or "MIH"
    Heaven.Session += 1
    local session = Heaven.Session
    task.spawn(function()
        Heaven.Busy = true
        local ok, err = pcall(function()
            if Heaven.Mode == "Peak" then
                Heaven.goPeakAndSummon()
            elseif Heaven.Mode == "Pucci" then
                Heaven.talkPucci()
            elseif Heaven.Mode == "AnasuiQuest" then
                Heaven.runAnasuiQuest()
            elseif string.sub(Heaven.Mode, 1, 2) == "DD" then
                Heaven.runDD(Heaven.Mode)
            elseif Heaven.Mode == "1v1" then
                Heaven.loop1v1()
            elseif Heaven.Mode == "SBR" then
                Heaven.loopSBR()
            else
                Heaven.loopMIH()
            end
        end)
        if not ok then
            warn("[Heaven] " .. tostring(err))
            Heaven.setStatus("Error: " .. tostring(err))
        end
        if Heaven.Session == session then
            Heaven.Active = false
            State.NoClip = false
        end
        Heaven.Busy = false
    end)
end

function Heaven.stop()
    Heaven.Active = false
    State.NoClip = false
    Heaven.setStatus("Stopped.")
end

function Heaven.switchTo(mode, onlyStep)
    if Heaven.Active then
        Heaven.Active = false
        local t = tick()
        while Heaven.Busy and tick() - t < 5 do task.wait(0.1) end
    end
    Heaven.OnlyStep = onlyStep
    Heaven.start(mode)
end

local heavenToggles = {}
local heavenSwitching = false
local function heavenMakeToggle(section, key, title, desc, icon, mode, onlyStep, pre)
    heavenToggles[key] = section:Toggle({
        Title = title, Desc = desc, Icon = icon, Value = false,
        Callback = function(state)
            if heavenSwitching then return end
            if state then
                heavenSwitching = true
                for otherKey, toggle in pairs(heavenToggles) do
                    if otherKey ~= key then pcall(function() toggle:Set(false) end) end
                end
                heavenSwitching = false
                if pre then pre() end
                task.spawn(function() Heaven.switchTo(mode, onlyStep) end)
            else
                Heaven.stop()
            end
        end,
    })
end

