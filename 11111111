    local STORY_NPCS = {
        {quest = "Help Giorno by Defeating Security Guards", npc = "Security Guard", offZ = 2, offY = 20},
        {quest = "Defeat Leaky Eye Luca", npc = "Leaky Eye Luca", offZ = 2, offY = 20},
