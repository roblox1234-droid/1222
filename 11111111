local function settingsStoreSerializeColor(c)
    if typeof(c) == "Color3" then
        return {R = c.R, G = c.G, B = c.B, __color = true}
    end
    return c
end

local function settingsStoreDeserializeColor(t)
    if type(t) == "table" and t.__color then
        return Color3.new(tonumber(t.R) or 1, tonumber(t.G) or 1, tonumber(t.B) or 1)
    end
    return t
end

local function settingsStoreDeepCopy(value, mode)
    if typeof(value) == "Color3" then
        return mode == "pack" and settingsStoreSerializeColor(value) or value
    end
    if type(value) ~= "table" then return value end
    local out = {}
    for k, v in pairs(value) do
        if mode == "pack" then
            out[k] = settingsStoreDeepCopy(v, "pack")
        else
            out[k] = settingsStoreDeepCopy(settingsStoreDeserializeColor(v), "unpack")
        end
    end
    return out
end

