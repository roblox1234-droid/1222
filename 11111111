local function settingsStoreDescribeAutoStart()
    local parts = {}
    local function add(flag, label)
        if flag then table.insert(parts, label) end
    end
    add(State.Farm == true, "Auto Farm")
    add(State.StandFarm == true, "Stand Farm")
    add(Config.AutoBuyLucky == true, "Auto Buy Lucky")
    add(State.ItemEsp == true, "Item ESP")
    add(State.PlayerEsp == true, "Player ESP")
    add(State.ItemTracker == true, "Item Tracker")
    add(State.PlayerTracker == true, "Player Tracker")
    add(State.NotifyItemSpawn == true, "Spawn Notify")
    add(Config.Player.NoClipEnabled == true, "No-Clip")
    add(Config.Player.WalkSpeedEnabled == true, "WalkSpeed")
    add(Config.Player.JumpPowerEnabled == true, "JumpPower")
    add(State.LowGraphics == true, "Low Graphics")
    add(Config.AutoRejoinEnabled == true, "Reload on kick")
    if #parts == 0 then
        return "Nothing enabled — turn features on, then press Save Auto-Start Config."
    end
    return "Will auto-start: " .. table.concat(parts, ", ")
end

