-- Stand -> Requiem / evolved form used by "Auto Requiem".
local StandFarmRequiem = {
    ["King Crimson"] = "King Crimson Requiem",
    ["Star Platinum"] = "Star Platinum: The World",
    ["Gold Experience"] = "Gold Experience Requiem",
    ["Silver Chariot"] = "Silver Chariot Requiem",
    ["Killer Queen"] = "Killer Queen Bites the Dust",
    ["D4C"] = "D4C Love Train",
    ["Crazy Diamond"] = "Crazy Diamond Requiem",
}

-- Alternate display names that map to the same evolution path
local StandFarmRequiemNameAliases = {
    ["kingcrimson:requiem"] = "King Crimson Requiem",
    ["kingcrimsonrequiem"] = "King Crimson Requiem",
    ["starplatinumtheworld"] = "Star Platinum: The World",
    ["starplatinum:theworld"] = "Star Platinum: The World",
    ["goldexperiencerequiem"] = "Gold Experience Requiem",
    ["silverchariotrequiem"] = "Silver Chariot Requiem",
    ["chariotrequiem"] = "Silver Chariot Requiem",
    ["killerqueenbitesthedust"] = "Killer Queen Bites the Dust",
    ["d4clovetrain"] = "D4C Love Train",
    ["crazydiamondrequiem"] = "Crazy Diamond Requiem",
}

local function standFarmCanonName(name)
    local n = StandFarm.normalize(name)
    if StandFarmRequiemNameAliases[n] then
        return StandFarmRequiemNameAliases[n]
    end
    return name
end

-- Reverse: evolved form -> base stand (SPTW skin path starts with SP, etc.)
function StandFarm.baseStandFor(name)
    local exact = StandFarm.normalize(standFarmCanonName(name))
    for base, requiemName in pairs(StandFarmRequiem) do
        if StandFarm.normalize(requiemName) == exact then
            return base
        end
    end
    -- Also match alias evolved names
    for aliasNorm, canonRequiem in pairs(StandFarmRequiemNameAliases) do
        if StandFarm.normalize(name) == aliasNorm then
            for base, requiemName in pairs(StandFarmRequiem) do
                if StandFarm.normalize(requiemName) == StandFarm.normalize(canonRequiem) then
                    return base
                end
            end
        end
    end
    return nil
end

-- True if the player selected an evolved form (directly or via Auto Requiem)
function StandFarm.selectedWantsEvolution()
    if State.StandFarmAutoRequiem == true then return true end
    for _, picked in ipairs(State.StandFarmSelected or {}) do
        if StandFarm.baseStandFor(picked) then return true end
        if StandFarm.isEvolvedName(picked) then return true end
    end
    for _, wanted in ipairs(State.StandFarmWanted or {}) do
        if StandFarm.baseStandFor(wanted) then return true end
        if StandFarm.isEvolvedName(wanted) then return true end
    end
    return false
end

-- If current is a base stand and target path is its Requiem, return Requiem name
function StandFarm.shouldAutoRequiem(current)
    local target = StandFarm.requiemTargetFor(current)
    if not target then return nil end
    if State.StandFarmAutoRequiem == true then return target end
    -- Selected list includes this base's evolved form
    for _, picked in ipairs(State.StandFarmSelected or {}) do
        local canon = standFarmCanonName(picked)
        if StandFarm.normalize(canon) == StandFarm.normalize(target) then
            return target
        end
        if StandFarm.normalize(picked) == StandFarm.normalize(current) then
            -- base selected with Auto Requiem off: still evolve if skin filter implies evolved skins
            if StandFarm.skinFilterActive() then
                return target
            end
        end
    end
    for _, wanted in ipairs(State.StandFarmWanted or {}) do
        local canon = standFarmCanonName(wanted)
        if StandFarm.normalize(canon) == StandFarm.normalize(target) then
            return target
        end
    end
    return nil
end

