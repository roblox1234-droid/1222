function Selling.clickOptionAndWait(optionName, timeout)
    local deadline = tick() + (tonumber(timeout) or 8)
    local retryClickAt = 0
    local skipState = {lastSkip = 0, lastSig = nil}

    while tick() < deadline do
        local gui = Gui.currentDialogue()
        if not gui then
            task.wait()
        else
            local option = Gui.option(gui, optionName)
            if option and option.Parent and Gui.isVisible(option) then
                if tick() >= retryClickAt then
                    local before = Gui.dialogueSignature(gui)
                    if Gui.click(option) then
                        local transitionDeadline = math.min(deadline, tick() + 0.55)
                        repeat
                            task.wait()
                            local current = Gui.currentDialogue()
                            if not current then return true end
                            if current ~= gui or not Gui.dialogueActive(current) then
                                return true
                            end

                            local currentOption = Gui.option(current, optionName)
                            if not currentOption or not Gui.isVisible(currentOption) then
                                return true
                            end
                            if Gui.dialogueSignature(current) ~= before then
                                return true
                            end
                        until tick() >= transitionDeadline

                        retryClickAt = tick() + 0.05
                    else
                        retryClickAt = tick() + 0.02
                    end
                else
                    task.wait()
                end
            elseif not Gui.hasVisibleOptions(gui) then
                Gui.smartSkip(skipState)
                task.wait(0.02)
            else
                task.wait(0.03)
            end
        end
    end
    return false
end

-- Closes a leftover dialogue (e.g. merchant menu left open by an aborted sale) so sells are not blocked forever.
function Selling.clearStaleDialogue()
    if not Gui.currentDialogue() then return true end
    local untilAt = tick() + 2
    while Gui.currentDialogue() and tick() < untilAt do
        task.wait(0.1)
    end
    if Gui.currentDialogue() then
        pcall(Gui.hardCloseDialogue)
        task.wait(0.15)
    end
    return Gui.currentDialogue() == nil
end

function Selling.sell(toolName, targetTool)
    local tool = targetTool
    if not tool and type(toolName) == "string" then
        tool = Selling.find(toolName)
    end
    if not tool or not tool:IsA("Tool") or not Selling.inInventory(tool) then
        return false
    end
    if not Selling.allowed(tool.Name) then
        return false
    end

    if not Selling.clearStaleDialogue() then
        warn("[Sell] blocked: another dialogue is open and could not be closed")
        return false
    end

    Selling.equip(tool)
    task.wait()
    if not Selling.inInventory(tool) then return true end
    if not Selling.clearStaleDialogue() then
        warn("[Sell] blocked after equip: dialogue is open and could not be closed")
        return false
    end

    local ownedDialogue = nil
    local function abortSell(step)
        warn("[Sell] failed at step: " .. tostring(step) .. " | item=" .. tostring(tool.Name))
        local current = Gui.currentDialogue()
        if ownedDialogue or current then
            for _ = 1, 3 do
                pcall(Gui.skipClick)
                task.wait()
                if not Gui.currentDialogue() then break end
            end
            -- choice menus ignore skipClick; force-close so the next sale is not blocked
            if Gui.currentDialogue() then
                pcall(Gui.hardCloseDialogue)
                task.wait(0.1)
            end
        end
        return false
    end

    if not Selling.openMerchant() then warn("[Sell] could not open merchant dialogue") return false end
    ownedDialogue = Gui.currentDialogue()
    if not ownedDialogue then warn("[Sell] merchant dialogue not found") return false end
    if not Selling.clickOptionAndWait("Option1", 8) then return abortSell("merchant Option1 (1st)") end
    task.wait()

    local remote, merchant = Selling.merchantRemote()
    if not remote or not merchant then return abortSell("merchant remote missing") end
    local opened = pcall(function()
        remote:FireServer("PromptTriggered", merchant)
    end)
    if not opened or not Gui.waitDialogue(5) then return abortSell("2nd dialogue did not open") end

    if not Selling.clickOptionAndWait("Option1", 8) then return abortSell("merchant Option1 (2nd)") end
    task.wait()
    if not Selling.clickOptionAndWait("Option6", 8) then return abortSell("Option6 (sell)") end

    local confirmUntil = tick() + 4
    while Selling.inInventory(tool) and tick() < confirmUntil do
        task.wait()
    end
    if Selling.inInventory(tool) then return abortSell("item still in inventory after sell") end
    return true
end

local function acquireSellingLock(timeout)
    local started = tick()
    timeout = timeout or 60
    while State.Selling do
        if tick() - started >= timeout then
            return false
        end
        task.wait(0.03)
    end
    State.Selling = true
    return true
end

local function selectTools(predicate)
    local result = {}
    for _, tool in ipairs(Selling.tools()) do
        if not predicate or predicate(tool.Name) then
            table.insert(result, tool)
        end
    end
    return result
end

local function sellMatching(predicate, description, alreadyLocked)
    local ownsLock = not alreadyLocked
    if ownsLock and not acquireSellingLock(60) then
        notifySelling("Selling", "Another sell operation is still running.")
        return false
    end

    local sold = 0
    local ok, err = pcall(function()
        local maxPasses = 3
        for _ = 1, maxPasses do
            local current = selectTools(predicate)
            if #current == 0 then break end

            local soldBeforePass = sold
            for _, tool in ipairs(current) do
                if Selling.inInventory(tool) and Selling.allowed(tool.Name) and (not predicate or predicate(tool.Name)) then
                    local didSell = false
                    for attempt = 1, 2 do
                        if not Selling.inInventory(tool) then
                            didSell = true
                            sold += 1
                            break
                        end
                        local okSell, result = pcall(Selling.sell, tool.Name, tool)
                        if okSell and result then
                            didSell = true
                            sold += 1
                            break
                        end
                        if attempt < 2 then task.wait(0.12) end
                    end
                    if not didSell then task.wait() end
                end
            end

            if #selectTools(predicate) == 0 then break end
            if sold == soldBeforePass then break end
        end
    end)

    if ownsLock then State.Selling = false end
    if not ok then
        warn("[Methion] Selling failed: " .. tostring(err))
        notifySelling("Selling", "Selling stopped because an error occurred.")
        return false
    end

    Selling.updateItems()
    local remaining = #selectTools(predicate)
    if sold == 0 and remaining == 0 then
        notifySelling("Selling", "No " .. description .. " found.")
    elseif remaining > 0 then
        notifySelling("Selling", "Sold " .. sold .. " " .. description .. "; " .. remaining .. " still remain.")
    else
        notifySelling("Selling", "Sold " .. sold .. " " .. description .. ".")
    end
    return remaining == 0 and sold > 0
end

function Selling.sellAll(alreadyLocked)
