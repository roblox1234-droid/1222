function StandFarm.normalize(name)
    return (string.lower(tostring(name or "")):gsub("[^%w]", ""))
end

function StandFarm.isWanted(name)
    local lower = string.lower(tostring(name or ""))
    local exact = StandFarm.normalize(name)
    if exact == "" then return false end

    -- Exact match to selected stands (including Requiem forms picked directly).
    for _, picked in ipairs(State.StandFarmSelected) do
        if exact == StandFarm.normalize(picked) then return true end
    end

    -- Base stand selected -> its Requiem form also counts as wanted.
    for base, requiemName in pairs(StandFarmRequiem) do
        if exact == StandFarm.normalize(requiemName) then
            for _, picked in ipairs(State.StandFarmSelected) do
                if StandFarm.normalize(picked) == StandFarm.normalize(base) then return true end
            end
        end
        -- Requiem form selected -> base stand also accepted so Auto Requiem path works.
        if exact == StandFarm.normalize(base) then
            for _, picked in ipairs(State.StandFarmSelected) do
                if StandFarm.normalize(picked) == StandFarm.normalize(requiemName) then return true end
            end
        end
    end

    -- Custom names typed in the input match by part of the name.
    for _, wanted in ipairs(State.StandFarmWanted) do
        if wanted ~= "" and string.find(lower, wanted, 1, true) then return true end
    end
    return false
end

function StandFarm.parseWanted(text)
    local list = {}
    for token in string.gmatch(tostring(text or ""), "[^,;\n]+") do
        local cleaned = string.lower(token):gsub("^%s+", ""):gsub("%s+$", "")
        if cleaned ~= "" then table.insert(list, cleaned) end
    end
    return list
end

local STAND_FARM_WORTHINESS = {"Worthiness", "Worthiness II", "Worthiness III", "Worthiness IV", "Worthiness V"}

-- RemoteFunction:InvokeServer can wait forever if the server never answers, which froze the farm.
-- This runs the call in its own thread and gives up after `timeout` seconds.
function StandFarm.invoke(rf, timeout, ...)
    local args = table.pack(...)
    local done, ok, result = false, false, nil
    task.spawn(function()
        ok, result = pcall(function()
            return rf:InvokeServer(table.unpack(args, 1, args.n))
        end)
        done = true
    end)
    local deadline = tick() + (timeout or 3)
    while not done and tick() < deadline do task.wait(0.05) end
    return done and ok, result
end

-- Returns true if the given Worthiness skill is already learned on CharacterSkillTree.
function StandFarm.hasWorthinessSkill(skillName)
    local tree = LP:FindFirstChild("CharacterSkillTree")
    if not tree then return false end
    local node = tree:FindFirstChild(tostring(skillName))
    if not node then return false end
    local ok, value = pcall(function() return node.Value end)
    if not ok then return false end
    -- Learned can be true / 1 / "true" depending on the value type
    if value == true or value == 1 then return true end
    if type(value) == "string" then
        local lower = string.lower(value)
        return lower == "true" or lower == "1" or lower == "yes"
    end
    return false
end

-- Returns true if all Worthiness skills up to the configured level are already learned.
function StandFarm.hasWorthinessUpTo(level)
    level = math.clamp(math.floor(tonumber(level) or tonumber(State.StandFarmWorthinessLevel) or 1), 1, #STAND_FARM_WORTHINESS)
    for index = 1, level do
        if not StandFarm.hasWorthinessSkill(STAND_FARM_WORTHINESS[index]) then
            return false
        end
    end
    return true
end

-- Learns Worthiness skills on the Character skill tree (used by Stand Farm auto-learn toggle).
-- skillList is optional; otherwise uses State.StandFarmWorthinessLevel (1–5).
-- forceRelearn = true: always send LearnSkill (needed after Rokakaka, tree can lag).
function StandFarm.learnWorthiness(skillList, requireFarmRunning, forceRelearn)
    if not skillList then
        local level = math.clamp(math.floor(tonumber(State.StandFarmWorthinessLevel) or 1), 1, #STAND_FARM_WORTHINESS)
        skillList = {}
        for index = 1, level do skillList[index] = STAND_FARM_WORTHINESS[index] end
    end

    local toLearn = {}
    for _, skillName in ipairs(skillList) do
        if forceRelearn or not StandFarm.hasWorthinessSkill(skillName) then
            table.insert(toLearn, skillName)
        end
    end

    if #toLearn == 0 then
        StandFarm.setStatus("Worthiness already learned (up to level " .. tostring(#skillList) .. ").")
        return true
    end

    StandFarm.setStatus("Learning Worthiness: " .. table.concat(toLearn, ", "))

    local sent = 0
    for _, skillName in ipairs(toLearn) do
        if requireFarmRunning ~= false and not State.StandFarm then return false end

        local character = LP.Character
        if not character then
            character = LP.CharacterAdded:Wait()
        end
        local remoteFunction = character and (character:FindFirstChild("RemoteFunction") or character:WaitForChild("RemoteFunction", 5))
        if not remoteFunction or not remoteFunction:IsA("RemoteFunction") then
            StandFarm.setStatus("Worthiness: no RemoteFunction on character.")
            return false
        end

        -- Match Auto Prestige: direct InvokeServer LearnSkill on Character tree
        local okInvoke = false
        for attempt = 1, 3 do
            local ok = pcall(function()
                remoteFunction:InvokeServer("LearnSkill", {
                    Skill = skillName,
                    SkillTreeType = "Character",
                })
            end)
            if ok then
                okInvoke = true
                break
            end
            task.wait(0.15)
        end

        if okInvoke then
            sent += 1
            -- Brief wait, then check if the tree flipped
            task.wait(0.2)
            if StandFarm.hasWorthinessSkill(skillName) then
                StandFarm.setStatus("Worthiness learned: " .. skillName)
            else
                -- Still send was accepted; tree can update a bit later
                StandFarm.setStatus("Worthiness request sent: " .. skillName)
            end
        else
            StandFarm.setStatus("Worthiness request failed: " .. skillName)
        end

        task.wait(0.15)
    end

    task.wait(0.25)
    if StandFarm.hasWorthinessUpTo(#skillList) then
        StandFarm.setStatus("Worthiness ready.")
        return true
    end
    return sent > 0
end

-- Skin detection -------------------------------------------------------
local function standFarmUsefulText(value)
    if value == nil then return nil end
    local text = tostring(value)
    if text == "" or text == "false" or text == "true" or text == "0" or tonumber(text) then return nil end
    return text
end

function StandFarm.readSkin()
    local exactNames = {"Skin", "StandSkin", "SkinName", "CurrentSkin", "StandSkinName"}
    local hints = {"skin", "variant", "shiny"}
    local roots = {}
    local stats = LP:FindFirstChild("PlayerStats")
    if stats then table.insert(roots, stats) end
    local char = LP.Character
    if char then table.insert(roots, char) end
    local morph = char and char:FindFirstChild("StandMorph")
    if morph then table.insert(roots, morph) end

    -- Prefer exact value names first
    for _, root in ipairs(roots) do
        for _, name in ipairs(exactNames) do
            local node = root:FindFirstChild(name, true)
            if node and node:IsA("ValueBase") then
                local okValue, value = pcall(function() return node.Value end)
                local text = okValue and standFarmUsefulText(value) or nil
                if text then return text end
            end
        end
    end

    for _, root in ipairs(roots) do
        for _, hint in ipairs(hints) do
            local okAttr, attributes = pcall(function() return root:GetAttributes() end)
            if okAttr then
                for key, value in pairs(attributes) do
                    if string.find(string.lower(tostring(key)), hint, 1, true) then
                        local text = standFarmUsefulText(value)
                        if text then return text end
                    end
                end
            end
            for _, object in ipairs(root:GetDescendants()) do
                if object:IsA("ValueBase") and string.find(string.lower(object.Name), hint, 1, true) then
                    local okValue, value = pcall(function() return object.Value end)
                    local text = okValue and standFarmUsefulText(value) or nil
                    if text then return text end
                end
            end
        end
    end
    return "Default"
end

function StandFarm.skinFilterActive()
    return #State.StandFarmSkinsSelected > 0 or #State.StandFarmSkinsCustom > 0
end

-- Evolved versions: Requiem / Over Heaven / Bites the Dust / Love Train forms and skins named after them.
local STANDFARM_EVOLVED_MARKERS = {"requiem", "overheaven", "bitesthedust", "lovetrain", "evolved", "evolution"}

function StandFarm.isEvolvedName(name)
    local n = StandFarm.normalize(name)
    if n == "" then return false end
    for _, requiemName in pairs(StandFarmRequiem) do
        if n == StandFarm.normalize(requiemName) then return true end
    end
    for _, marker in ipairs(STANDFARM_EVOLVED_MARKERS) do
        if string.find(n, marker, 1, true) then return true end
    end
    return false
end

-- standName (optional) is the stand that carries the skin. An evolved stand / evolved skin is never
-- skipped because of the skin filter, so a needed stand is not reset after evolving.
function StandFarm.skinMatches(skin, standName)
    if not StandFarm.skinFilterActive() then return true end
    local lower = string.lower(tostring(skin or "Default"))
    local exact = StandFarm.normalize(skin or "Default")
    for _, picked in ipairs(State.StandFarmSkinsSelected) do
        if exact == StandFarm.normalize(picked) then return true end
    end
    for _, wanted in ipairs(State.StandFarmSkinsCustom) do
        if wanted ~= "" and string.find(lower, wanted, 1, true) then return true end
    end

    -- Evolved version of a wanted skin (e.g. wanted "Crazy Idol" -> "Crazy Idol Requiem").
    if StandFarm.isEvolvedName(skin) then
        for _, picked in ipairs(State.StandFarmSkinsSelected) do
            local base = StandFarm.normalize(picked)
            if base ~= "" and #exact > #base and string.sub(exact, 1, #base) == base then return true end
        end
        for _, wanted in ipairs(State.StandFarmSkinsCustom) do
            local base = StandFarm.normalize(wanted)
            if base ~= "" and string.find(exact, base, 1, true) then return true end
        end
    end

    -- Any evolved skin / evolved stand form is kept (can be turned off in the settings).
    if State.StandFarmKeepEvolved ~= false then
        if StandFarm.isEvolvedName(skin) or StandFarm.isEvolvedName(standName) then return true end
    end
    return false
end

function StandFarm.addSkinOption(skin)
    skin = tostring(skin or "")
    if skin == "" then return end
    for _, existing in ipairs(StandFarmSkins) do
        if StandFarm.normalize(existing) == StandFarm.normalize(skin) then return end
    end
    table.insert(StandFarmSkins, skin)
    if StandFarm.SkinDropdown then
        pcall(function() StandFarm.SkinDropdown:Refresh(StandFarmSkins, true) end)
    end
end

-- Summons the stand if needed (the skin is only visible on the stand model) and reads the skin.
function StandFarm.currentSkin()
    local char = LP.Character
    local rf = char and char:FindFirstChild("RemoteFunction")
    if char and not char:FindFirstChild("StandMorph") and rf and rf:IsA("RemoteFunction") then
        for _ = 1, 4 do
            if char:FindFirstChild("StandMorph") then break end
            StandFarm.invoke(rf, 3, "ToggleStand", "Toggle")
            task.wait(0.4)
        end
    end
    local skin = StandFarm.readSkin()
    StandFarm.addSkinOption(skin)
    return skin
end

-- Auto Requiem ---------------------------------------------------------
function StandFarm.requiemTargetFor(standName)
    local exact = StandFarm.normalize(standName)
    for base, requiemName in pairs(StandFarmRequiem) do
        if StandFarm.normalize(base) == exact then return requiemName end
    end
    return nil
end

-- Teleport to Suno (Merchant's Keep) and talk to obtain a Requiem Arrow
function StandFarm.talkSunoForRequiemArrow()
    local before = countInventoryName(REQUIEM_ARROW_NAME)
    StandFarm.Away = true
    StandFarm.setStatus("Teleporting to Suno (Merchant's Keep) for Requiem Arrow...")

    local keepPos = (Config.Teleport and Config.Teleport.Locations and Config.Teleport.Locations["Merchant's Keep"])
        or Vector3.new(-620.4, -25.8, -465.1)
    pcall(function()
        Move.goToCF(CFrame.new(keepPos + Vector3.new(0, 3, 0)), Config.Teleport and Config.Teleport.Mode or "tween")
    end)

    local dialogues = workspace:FindFirstChild("Dialogues")
    local suno = nil
    if dialogues then
        for _, name in ipairs({"Suno", "Arrowsmith", "Suno the Arrowsmith", "Arrow Smith"}) do
            suno = dialogues:FindFirstChild(name) or dialogues:FindFirstChild(name, true)
            if suno then break end
        end
        if not suno then
            for _, child in ipairs(dialogues:GetChildren()) do
                local n = string.lower(child.Name)
                if string.find(n, "suno", 1, true) or string.find(n, "arrowsmith", 1, true) then
                    suno = child
                    break
                end
            end
        end
    end

    if not suno then
        -- fallback to CDR helper if available
        local okCdr = false
        pcall(function()
            if type(CDR) == "table" and type(CDR.talkSuno) == "function" then
                okCdr = CDR.talkSuno() == true
            end
        end)
        StandFarm.Away = false
        if okCdr and countInventoryName(REQUIEM_ARROW_NAME) > before then
            return true
        end
        StandFarm.setStatus("Suno not found — cannot get Requiem Arrow.")
        return false
    end

    local part = suno:IsA("BasePart") and suno or suno:FindFirstChildWhichIsA("BasePart", true)
    if part then
        pcall(function()
            Move.goToCF(CFrame.new(part.Position + Vector3.new(0, 3, 3)), Config.Teleport and Config.Teleport.Mode or "tween")
        end)
    end

    local character = LP.Character
    local remote = character and character:FindFirstChild("RemoteEvent")
    local dialogueFolder = ReplicatedStorage:FindFirstChild("Dialogue")
    local dialogueNameObj = suno:FindFirstChild("Dialogue")
    local dialogueName = dialogueNameObj and tostring(dialogueNameObj.Value or "") or suno.Name
    local template = dialogueFolder and (dialogueFolder:FindFirstChild(dialogueName) or dialogueFolder:FindFirstChild(suno.Name))

    if remote and template then
        pcall(function() remote:FireServer("PromptTriggered", template) end)
    elseif remote then
        pcall(function()
            remote:FireServer("DialogueInteracted", { DialogueName = dialogueName, Speaker = suno.Name })
        end)
    end

    local gui = Gui.waitDialogue(4)
    if not gui then
        StandFarm.Away = false
        StandFarm.setStatus("Could not open Suno dialogue.")
        return false
    end

    -- Click through dialogue preferring Requiem / Arrow / Yes options
    for _ = 1, 8 do
        local current = Gui.currentDialogue()
        if not current then break end
        local clicked = false
        for _, optionName in ipairs({"Option1", "Option2", "Option3", "Option4", "Option5", "Option6"}) do
            local btn = Gui.option(current, optionName)
            if btn and Gui.isVisible(btn) then
                local text = string.lower(tostring(btn.Text or ""))
                for _, child in ipairs(btn:GetDescendants()) do
                    if child:IsA("TextLabel") or child:IsA("TextButton") then
                        text = text .. " " .. string.lower(tostring(child.Text or ""))
                    end
                end
                if text:find("requiem", 1, true) or text:find("arrow", 1, true)
                    or text:find("evolve", 1, true) or text:find("yes", 1, true)
                    or text:find("quest", 1, true) or text:find("accept", 1, true)
                    or optionName == "Option1" then
                    if Gui.click(btn) then
                        clicked = true
                        task.wait(0.15)
                        break
                    end
                end
            end
        end
        if not clicked then
            pcall(function() Gui.waitAndClickOption("Option1", 1.5) end)
        end
        if not Gui.hasVisibleOptions(current) then
            pcall(Gui.skipClick)
        end
        task.wait(0.12)
        if countInventoryName(REQUIEM_ARROW_NAME) > before then break end
    end

    pcall(function() Gui.advanceUntilClosed(3) end)
    task.wait(0.2)

    -- Return near safe zone after talking
    pcall(function()
        if StandFarm.SafeSpot then Move.teleSafe() end
    end)

    StandFarm.Away = false
    local got = countInventoryName(REQUIEM_ARROW_NAME) > before
    if not got then
        got = StandFarm.findTool(REQUIEM_ARROW_NAME) ~= nil
    end
    if got then
        StandFarm.setStatus("Got Requiem Arrow from Suno — injecting...")
        -- Immediately inject if we currently have a stand
        local current = StandFarm.standName()
        if StandFarm.hasStand(current) then
            pcall(function()
                StandFarm.learnWorthiness({"Worthiness", "Worthiness II", "Worthiness III", "Worthiness IV", "Worthiness V"})
            end)
            local used = false
            pcall(function()
                used = StandFarm.useTool(REQUIEM_ARROW_NAME) == true
            end)
            if used then
                StandFarm.setStatus("Requiem Arrow injected on " .. tostring(current))
            else
                StandFarm.setStatus("Requiem Arrow ready (inject retry on next step).")
            end
        else
            StandFarm.setStatus("Got Requiem Arrow — waiting for a stand to inject.")
        end
    else
        StandFarm.setStatus("Suno talk done — no new Requiem Arrow detected.")
    end
    return got or StandFarm.findTool(REQUIEM_ARROW_NAME) ~= nil
end

function StandFarm.ensureRequiemArrow()
    if StandFarm.findTool(REQUIEM_ARROW_NAME) then return true end
    StandFarm.setStatus("No Requiem Arrow — going to Suno...")
    for attempt = 1, 3 do
        if not State.StandFarm then return false end
        if StandFarm.talkSunoForRequiemArrow() and StandFarm.findTool(REQUIEM_ARROW_NAME) then
            return true
        end
        -- If still none: sell junk (free inventory / money for other steps) then retry Suno
        StandFarm.sellJunkForMoney()
        task.wait(0.35)
    end
    return StandFarm.findTool(REQUIEM_ARROW_NAME) ~= nil
end

function StandFarm.useRequiemArrow(targetName)
    if not StandFarm.findTool(REQUIEM_ARROW_NAME) then return false, "no Requiem Arrow in your inventory" end
    StandFarm.setStatus("Learning Worthiness I-V for Requiem...")
    StandFarm.learnWorthiness({"Worthiness", "Worthiness II", "Worthiness III", "Worthiness IV", "Worthiness V"})

    StandFarm.setStatus("Using Requiem Arrow...")
    if not StandFarm.useTool(REQUIEM_ARROW_NAME) then return false, "could not use the Requiem Arrow" end

    local wanted = StandFarm.normalize(targetName)
    local deadline = tick() + 14
    while tick() < deadline and State.StandFarm do
        if StandFarm.normalize(StandFarm.standName()) == wanted then return true end
        task.wait(0.25)
    end
    return StandFarm.normalize(StandFarm.standName()) == wanted, "the stand did not change to " .. targetName
end

function StandFarm.findTool(name)
    local char = LP.Character
    local tool = char and char:FindFirstChild(name)
    if tool and tool:IsA("Tool") then return tool end
    local backpack = LP:FindFirstChild("Backpack")
    tool = backpack and backpack:FindFirstChild(name)
    if tool and tool:IsA("Tool") then return tool end
    return nil
end

function StandFarm.useTool(name)
    local char = LP.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    local tool = StandFarm.findTool(name)
    if not char or not hum or hum.Health <= 0 or not tool then return false end

    pcall(function() hum:EquipTool(tool) end)
    local equipped
    for _ = 1, 12 do
        equipped = char:FindFirstChild(name)
        if equipped and equipped:IsA("Tool") then break end
        task.wait(0.03)
    end
    if not equipped then return false end

    -- Short equip settle (was ~0.2–1.2s; keep low so arrows fire faster)
    local pace = math.clamp((tonumber(State.StandFarmLoopDelay) or 0.03) * 0.15, 0.01, 0.12)
    task.wait(pace)
    pcall(function() equipped:Activate() end)

    -- Auto Click at screen coords when injecting Arrow / Rokakaka / Requiem Arrow
    local injectNames = {
        ["Mysterious Arrow"] = true,
        ["Rokakaka"] = true,
        ["Pure Rokakaka"] = true,
        ["Requiem Arrow"] = true,
    }
    if State.StandFarmAutoClick == true and injectNames[name] then
        task.spawn(function()
            task.wait(0.28)
            pcall(Gui.farmStartClick)
        end)
    end

    -- Confirmation Yes: faster poll, still no spam
    local gui = Gui.waitDialogue(3.5)
    if gui then
        local clicked = false
        task.wait(0.08)
        pcall(function()
            clicked = Gui.waitAndClickOption("Option1", 2.5) == true
        end)
        if not clicked then
            for _ = 1, 4 do
                local current = Gui.currentDialogue()
                if not current then break end
                local opt = Gui.option(current, "Option1")
                if opt and Gui.isVisible(opt) and Gui.click(opt) then
                    clicked = true
                    break
                end
                task.wait(0.12)
            end
        end
        if not clicked and State.StandFarmAutoClick == true and Gui.currentDialogue() then
            task.wait(0.15)
            pcall(Gui.farmStartClick)
            task.wait(0.1)
            local opt = Gui.option(Gui.currentDialogue(), "Option1")
            if opt and Gui.isVisible(opt) then
                pcall(function() Gui.click(opt) end)
            end
        end
        local closeDeadline = tick() + 2
        while tick() < closeDeadline do
            if not Gui.currentDialogue() then break end
            task.wait(0.05)
        end
    end
    return true
end

function StandFarm.waitStand(wantStand, timeout)
    local deadline = tick() + timeout
    while tick() < deadline and State.StandFarm do
        StandFarm.Beat = tick()
        if StandFarm.hasStand(StandFarm.standName()) == wantStand then return true end
        task.wait(0.08)
    end
    return StandFarm.hasStand(StandFarm.standName()) == wantStand
end

-- Restock -----------------------------------------------------------------
-- When arrows or Rokakakas run out: buy them (if you can afford it) or farm them from the map.
local STAND_FARM_SHOP = {
    [ARROW_NAME] = {shopName = "1x Mysterious Arrow", price = 750},
    [ROKAKAKA_NAME] = {shopName = "1x Rokakaka", price = 2500},
}

function StandFarm.buyItems(itemName, amount)
    local info = STAND_FARM_SHOP[itemName]
    if not info then return false end
    local target = countInventoryName(itemName) + amount
    local failures = 0
    while State.StandFarm and countInventoryName(itemName) < target do
        if Utils.money() < info.price then break end
        local before = countInventoryName(itemName)
        StandFarm.setStatus(string.format("Buying %s (%d/%d)...", itemName, before, target))
        Shop.buy(info.shopName)
        local deadline = tick() + 1.6
        while tick() < deadline and countInventoryName(itemName) <= before do task.wait(0.06) end
        if countInventoryName(itemName) <= before then
            failures += 1
            if failures >= 3 then break end
        else
            failures = 0
        end
        task.wait(0.08)
    end
    return countInventoryName(itemName) > 0
end

function StandFarm.collectItems(itemName, amount)
    local previousFilter = Config.FarmOnlyItems
    local farmWasOn = State.Farm == true
    local target = countInventoryName(itemName) + amount

    Config.FarmOnlyItems = {itemName}
    MethionSH_Env.__MethionSHFarmOnlyItems = Config.FarmOnlyItems
    if not farmWasOn then
        pcall(function() AutoFarmToggle:Set(true) end)
        if State.Farm ~= true then
            State.Farm = true
            State.NoClip = true
            pcall(function() ItemESP.scan() end)
        end
    end

    local deadline = tick() + 900
    while State.StandFarm and tick() < deadline and countInventoryName(itemName) < target do
        StandFarm.setStatus(string.format("Farming %s from the map (%d/%d)...", itemName, countInventoryName(itemName), target))
        StandFarm.updateCounts()
        task.wait(0.35)
    end

    if not farmWasOn then
        pcall(function() AutoFarmToggle:Set(false) end)
        if State.Farm == true then State.Farm = false end
    end
    Config.FarmOnlyItems = previousFilter
    MethionSH_Env.__MethionSHFarmOnlyItems = previousFilter
    return countInventoryName(itemName) > 0
end

-- Returns true when at least one of the item is available afterwards.
StandFarm.SafeSpot = true
StandFarm.Away = false
function StandFarm.restock(itemName)
    StandFarm.Away = true
    local ok, result = pcall(StandFarm.restockInner, itemName)
    StandFarm.Away = false
    if not ok then error(result) end
    return result
end

-- Sell unneeded sellable items (keep arrows / rokakaka / requiem / lucky for farm)
function StandFarm.sellJunkForMoney()
    local protect = {
        [ARROW_NAME] = true,
        [ROKAKAKA_NAME] = true,
        [REQUIEM_ARROW_NAME] = true,
        ["Lucky Arrow"] = true,
        ["Mysterious Arrow"] = true,
        ["Rokakaka"] = true,
        ["Requiem Arrow"] = true,
    }
    StandFarm.setStatus("Not enough money — selling unneeded items...")
    StandFarm.Away = true
    local soldAny = false
    pcall(function()
        local locked = false
        if not State.Selling then
            State.Selling = true
            locked = true
        end
        local ok = pcall(function()
            sellMatching(function(name)
                if protect[name] then return false end
                return Selling.allowed(name) == true
            end, "junk items", true)
        end)
        if locked then State.Selling = false end
        soldAny = ok == true
    end)
    StandFarm.Away = false
    task.wait(0.25)
    return soldAny
end

function StandFarm.buyOneIfNeeded(itemName)
    local info = STAND_FARM_SHOP[itemName]
    if not info then return false end
    if countInventoryName(itemName) > 0 then return true end
    if State.StandFarmAutoBuy == false then return false end

    -- Buy exactly 1
    if Utils.money() < info.price then
        StandFarm.sellJunkForMoney()
    end
    if Utils.money() >= info.price then
        StandFarm.setStatus("Buying 1x " .. tostring(itemName) .. "...")
        if StandFarm.buyItems(itemName, 1) and countInventoryName(itemName) > 0 then
            return true
        end
    end

    -- Still broke: sell again and retry once
    if Utils.money() < info.price then
        StandFarm.sellJunkForMoney()
    end
    if Utils.money() >= info.price then
        StandFarm.setStatus("Retry buy 1x " .. tostring(itemName) .. "...")
        return StandFarm.buyItems(itemName, 1) and countInventoryName(itemName) > 0
    end
    return false
end

function StandFarm.restockInner(itemName)
    local amount = math.clamp(math.floor(tonumber(State.StandFarmRestockAmount) or 5), 1, 25)
    local info = STAND_FARM_SHOP[itemName]
    if State.StandFarmAutoBuy and info and Utils.money() >= info.price then
        if StandFarm.buyItems(itemName, amount) then return true end
    end
    if State.StandFarmAutoCollect and State.StandFarm then
        StandFarm.setStatus("Out of " .. itemName .. ". Farming it from the map...")
        if StandFarm.collectItems(itemName, amount) then return true end
    end
    return countInventoryName(itemName) > 0
end

function StandFarm.stop(reason)
    State.StandFarm = false
    State.StandFarmBusy = false
    StandFarm.Generation += 1
    StandFarm.Session += 1
    StandFarm.setStatus(reason or "Stopped.")
    StandFarm.updateCounts()
end

function StandFarm.start()
    State.StandFarmWanted = StandFarm.parseWanted(StandFarm.WantedText)
    if #State.StandFarmWanted == 0 and #State.StandFarmSelected == 0 then
        State.StandFarm = false
        standFarmNotify("Pick at least one stand in \"Stands To Keep\" (or type a custom name) first.", "Warning")
        return false
    end
    if State.Selling then
        State.StandFarm = false
        standFarmNotify("Wait for selling to finish.", "Warning")
        return false
    end

    State.StandFarm = true
    StandFarm.Rolls = 0
    StandFarm.Restarts = 0
    StandFarm.Session += 1
    local session = StandFarm.Session

    -- Keep the character at the safe spot while rolling (not while buying / collecting items)
    task.spawn(function()
        while State.StandFarm and StandFarm.Session == session do
            if StandFarm.SafeSpot and not StandFarm.Away and not State.Selling then
                local char = LP.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - Config.SafeZone).Magnitude > 25 then
                    pcall(Move.teleSafe)
                end
            end
            task.wait(2)
        end
    end)
    local failures = 0
    local worthyDone = false
    local forceWorthinessRelearn = false
    local worthyAttempts = 0
    local lastWorthyTry = 0

    -- The loop lives in a closure so the watchdog can start it again if it gets stuck.
    local function launch()
    StandFarm.Generation += 1
    local generation = StandFarm.Generation
    StandFarm.Beat = tick()

    task.spawn(function()
      local okLoop, errLoop = pcall(function()
        local function alive() return State.StandFarm and StandFarm.Generation == generation end

        while alive() do
            StandFarm.Beat = tick()
            local char = LP.Character
            local hum = char and char:FindFirstChildWhichIsA("Humanoid")
            if not char or not hum or hum.Health <= 0 or not char:FindFirstChild("HumanoidRootPart") then
                State.StandFarmBusy = false
                StandFarm.setStatus("Waiting for your character...")
                task.wait(0.5)
                continue
            end
            if State.Selling then
                StandFarm.setStatus("Waiting for selling to finish...")
                task.wait(0.5)
                continue
            end

            local current = StandFarm.standName()
            StandFarm.updateCounts()

            local keep = false
            local skinText = nil
            if StandFarm.hasStand(current) and StandFarm.isWanted(current) then
                keep = true
                if StandFarm.skinFilterActive() then
                    StandFarm.setStatus("Checking skin of " .. current .. "...")
                    skinText = StandFarm.currentSkin()
                    if not StandFarm.skinMatches(skinText, current) then
                        keep = false
                        warn("[Stand Farm] RESET by skin filter: stand=" .. tostring(current) .. " skin=" .. tostring(skinText)
                            .. " selectedSkins=" .. table.concat(State.StandFarmSkinsSelected, "|")
                            .. " customSkins=" .. table.concat(State.StandFarmSkinsCustom, "|"))
                        StandFarm.setStatus(current .. " skin \"" .. tostring(skinText) .. "\" not wanted — resetting.")
                    else
                        StandFarm.setStatus(current .. " skin match: " .. tostring(skinText))
                    end
                end
            end

            if keep then
                -- Optional Worthiness on the stand you keep.
                if State.StandFarmLearnWorthiness then
                    if StandFarm.hasWorthinessUpTo() then
                        StandFarm.setStatus("Worthiness already learned — skipping.")
                    else
                        StandFarm.setStatus("Learning Worthiness...")
                        StandFarm.learnWorthiness()
                        task.wait(0.5)
                    end
                end

                local finalName = current
                local note = ""
                local requiemName = State.StandFarmAutoRequiem and StandFarm.requiemTargetFor(current) or nil
                if requiemName then
                    State.StandFarmBusy = true
                    StandFarm.setStatus("Evolving to " .. tostring(requiemName) .. "...")
                    local okRequiem, why = StandFarm.useRequiemArrow(requiemName)
                    if okRequiem then
                        finalName = StandFarm.standName()
                        -- Re-check skin after Requiem (works for Requiem stand skins too).
                        if StandFarm.skinFilterActive() then
                            task.wait(0.35)
                            skinText = StandFarm.currentSkin()
                            if not StandFarm.skinMatches(skinText, finalName) then
                                keep = false
                                StandFarm.setStatus(finalName .. " skin \"" .. tostring(skinText) .. "\" not wanted after Requiem — resetting.")
                            end
                        end
                    else
                        note = " (Requiem failed: " .. tostring(why) .. ")"
                    end
                end

                if keep then
                    local skinNote = skinText and (" [skin: " .. tostring(skinText) .. "]") or ""
                    StandFarm.stop("Got " .. finalName .. "!" .. skinNote .. note)
                    standFarmNotify("Got " .. finalName .. skinNote .. " after " .. tostring(StandFarm.Rolls) .. " rolls." .. note, "Success", 8)
                    break
                end
                -- keep became false after Requiem skin mismatch -> fall through to Rokakaka
            end

            State.StandFarmBusy = true
            if StandFarm.hasStand(current) then
                warn("[Stand Farm] NOT KEPT: stand='" .. tostring(current) .. "' wanted=" .. tostring(StandFarm.isWanted(current))
                    .. " selected=" .. table.concat(State.StandFarmSelected, "|"))
                -- Unwanted stand: remove it with a Rokakaka.
                if countInventoryName(ROKAKAKA_NAME) <= 0 and not StandFarm.restock(ROKAKAKA_NAME) then
                    StandFarm.stop("Out of Rokakaka (and could not buy or farm more). Current stand: " .. current)
                    standFarmNotify("Out of Rokakaka. Stopped on " .. current .. ".", "Warning", 7)
                    break
                end
                if not alive() then break end
                StandFarm.setStatus("Removing " .. current .. " with Rokakaka...")
                StandFarm.useTool(ROKAKAKA_NAME)
                if StandFarm.waitStand(false, 8) then
                    failures = 0
                    -- Rokakaka resets skill points — relearn Worthiness immediately after every reset.
                    worthyDone = false
                    forceWorthinessRelearn = true
                    task.wait(0.25)
                    StandFarm.setStatus("Stand reset — learning Worthiness again...")
                    local okWorthy = StandFarm.learnWorthiness(nil, true, true)
                    if okWorthy or StandFarm.hasWorthinessUpTo() then
                        worthyDone = true
                        forceWorthinessRelearn = false
                        StandFarm.setStatus("Worthiness relearned after Rokakaka.")
                    else
                        worthyDone = false
                        forceWorthinessRelearn = true
                        StandFarm.setStatus("Worthiness relearn failed — will retry before arrow.")
                    end
                    task.wait(math.clamp((tonumber(State.StandFarmLoopDelay) or 0.03) * 0.2, 0.01, 0.12))
                else
                    failures += 1
                end
            else
                -- No stand: ensure Worthiness before every arrow roll.
                if forceWorthinessRelearn or not worthyDone or not StandFarm.hasWorthinessUpTo() then
                    if tick() - lastWorthyTry >= 0.35 then
                        lastWorthyTry = tick()
                        worthyAttempts += 1
                        local mustForce = forceWorthinessRelearn == true or not StandFarm.hasWorthinessUpTo()
                        StandFarm.setStatus(mustForce
                            and "Learning Worthiness before roll..."
                            or "Checking Worthiness before roll...")
                        local okWorthy = StandFarm.learnWorthiness(nil, true, mustForce)
                        if okWorthy or StandFarm.hasWorthinessUpTo() then
                            worthyDone = true
                            forceWorthinessRelearn = false
                            StandFarm.setStatus("Worthiness ready. Rolling arrow...")
                        else
                            worthyDone = false
                            forceWorthinessRelearn = true
                            StandFarm.setStatus("Worthiness learn failed (attempt " .. tostring(worthyAttempts) .. "). Will retry...")
                        end
                        task.wait(0.08)
                    end
                end
                if countInventoryName(ARROW_NAME) <= 0 and not StandFarm.restock(ARROW_NAME) then
                    StandFarm.stop("Out of Mysterious Arrows (and could not buy or farm more).")
                    standFarmNotify("Out of Mysterious Arrows. Stopped.", "Warning", 7)
                    break
                end
                if not alive() then break end
                StandFarm.setStatus("Using Mysterious Arrow (roll " .. tostring(StandFarm.Rolls + 1) .. ")...")
                StandFarm.useTool(ARROW_NAME)
                if StandFarm.waitStand(true, 10) then
                    StandFarm.Rolls += 1
                    failures = 0
                    task.wait(math.clamp((tonumber(State.StandFarmLoopDelay) or 0.03) * 0.25, 0.01, 0.15))
                    StandFarm.setStatus("Rolled " .. StandFarm.standName())
                else
                    failures += 1
                end
            end

            if failures >= 5 then
                StandFarm.stop("Stopped: item use keeps failing. Check your items and try again.")
                standFarmNotify("Item use failed 5 times in a row. Stopped.", "Warning", 7)
                break
            end

            pcall(function()
                local h = LP.Character and LP.Character:FindFirstChildWhichIsA("Humanoid")
                if h then h:UnequipTools() end
            end)
            task.wait(math.max(0.02, tonumber(State.StandFarmLoopDelay) or 0.03))
        end

        if StandFarm.Generation == generation then
            State.StandFarmBusy = false
        end
      end)
      if not okLoop then
        warn("[Stand Farm] " .. tostring(errLoop))
        if StandFarm.Generation == generation then
            StandFarm.Restarts += 1
            standFarmNotify("Stand Farm error — restarting loop (" .. tostring(StandFarm.Restarts) .. ")...", "Warning", 5)
            -- Soft restart first; hard script reload after several failures
            if StandFarm.Restarts >= 3 then
                ScriptRecovery.reload("Stand Farm: " .. tostring(errLoop))
            else
                task.wait(1)
                if State.StandFarm then
                    launch()
                end
            end
        end
      end
    end)
    end

    launch()

    -- Watchdog: checks the loop every 2 seconds. No progress for STUCK_AFTER seconds -> restart it.
    task.spawn(function()
        local STUCK_AFTER = 90
        while State.StandFarm and StandFarm.Session == session do
            task.wait(2)
            if State.StandFarm and StandFarm.Session == session and State.StandFarmWatchdog
                and tick() - StandFarm.Beat > STUCK_AFTER then
                StandFarm.Restarts += 1
                warn("[Stand Farm] Loop stuck for " .. tostring(math.floor(tick() - StandFarm.Beat)) .. "s. Restarting (" .. tostring(StandFarm.Restarts) .. ").")
                StandFarm.setStatus("Loop was stuck. Restarted it (" .. tostring(StandFarm.Restarts) .. ").")
                standFarmNotify("The loop was stuck and has been restarted.", "Warning", 5)
                State.StandFarmBusy = false
                launch()
            end
        end
    end)

    -- Optional screen click (toggle "Auto Click" in Stand Farm)
    if State.StandFarmAutoClick == true then
        task.spawn(function()
            pcall(Gui.farmStartClick)
        end)
    end

    standFarmNotify("Stand Farm started.", "Info", 3)
    return true
end

