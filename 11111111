})

local Heaven = {
    Active = false,
    Mode = "MIH",
    StatusLabel = nil,
    Session = 0,
    StepIndex = 1,
    StepKills = 0,
}

local HEAVEN_MIH_STEPS = {
    {name = "Thug", target = 30, labels = {"Thug"}},
    {name = "Alpha Thug", target = 25, labels = {"Alpha Thug"}},
    {name = "Corrupt Police", target = 20, labels = {"Corrupt Police"}},
    {name = "Zombie Henchman", target = 15, labels = {"Zombie Henchman"}},
    {name = "Vampire", target = 10, labels = {"Vampire"}},
}

local TALLEST_PEAK = Config.Teleport.Locations["The Tallest Peak"]
    or Vector3.new(-242.6, 284.2, 354.4)
local VAMPIRE_HIDEOUT = Config.Teleport.Locations["Vampire Hideout"]
    or Vector3.new(396.8, -31.5, -174.0)

local function heavenNotify(content, kind, duration)
    pcall(function()
        Window:Notify({
            Title = "Heaven / DD",
            Content = content,
            Type = kind or "Info",
            Duration = duration or 4,
        })
    end)
end

function Heaven.setStatus(text)
    if Heaven.StatusLabel and type(Heaven.StatusLabel.SetDesc) == "function" then
        pcall(function() Heaven.StatusLabel:SetDesc(tostring(text)) end)
    end
end

function Heaven.standName()
    local stats = LP:FindFirstChild("PlayerStats")
    local stand = stats and stats:FindFirstChild("Stand")
    if stand then return tostring(stand.Value or "") end
    return tostring(Utils.stat(LP, "Stand") or "")
end

function Heaven.findNpc(nameList)
    return CDR.findEnemyByNames(nameList)
end

function Heaven.kill(enemy)
    return CDR.killTarget(enemy)
end

function Heaven.talkPucci()
    Heaven.setStatus("Looking for Pucci...")
    local dialogues = workspace:FindFirstChild("Dialogues")
    local npc = nil
    if dialogues then
        for _, name in ipairs({"Pucci", "Enrico Pucci", "Father Pucci"}) do
            npc = dialogues:FindFirstChild(name) or dialogues:FindFirstChild(name, true)
            if npc then break end
        end
        if not npc then
            for _, child in ipairs(dialogues:GetChildren()) do
                local n = string.lower(child.Name)
                if string.find(n, "pucci", 1, true) then
                    npc = child
                    break
                end
            end
        end
    end
    if not npc then
        Heaven.setStatus("Pucci not found. Stand near him and retry.")
        return false
    end
    local part = npc:IsA("BasePart") and npc or npc:FindFirstChildWhichIsA("BasePart", true)
    if part then
        Move.goToCF(CFrame.new(part.Position + Vector3.new(0, 3, 3)), Config.Teleport.Mode)
    end
    local character = LP.Character
    local remote = character and character:FindFirstChild("RemoteEvent")
    local dialogueFolder = ReplicatedStorage:FindFirstChild("Dialogue")
    local dialogueNameObj = npc:FindFirstChild("Dialogue")
    local dialogueName = dialogueNameObj and tostring(dialogueNameObj.Value or "") or npc.Name
    local template = dialogueFolder and (dialogueFolder:FindFirstChild(dialogueName) or dialogueFolder:FindFirstChild(npc.Name))
    if remote and template then
        pcall(function() remote:FireServer("PromptTriggered", template) end)
    elseif remote then
        pcall(function()
            remote:FireServer("DialogueInteracted", { DialogueName = dialogueName, Speaker = npc.Name })
        end)
    end
    local gui = Gui.waitDialogue(4)
    if not gui then
        Heaven.setStatus("Pucci dialogue did not open.")
        return false
    end
    Gui.oneClick()
    task.wait(0.25)
    pcall(function() Gui.advanceUntilClosed(5) end)
    Heaven.setStatus("Pucci dialogue done.")
    return true
end

function Heaven.goPeakAndSummon()
    Heaven.setStatus("Going to The Tallest Peak...")
    Move.goToCF(CFrame.new(TALLEST_PEAK + Vector3.new(0, 5, 0)), Config.Teleport.Mode)
    task.wait(0.6)
    local char = LP.Character
    local rf = char and char:FindFirstChild("RemoteFunction")
    if rf then
        -- Unsummon then summon (evolution trigger for MIH / TWOH)
        for _ = 1, 2 do
            pcall(function() rf:InvokeServer("ToggleStand", "Toggle") end)
            task.wait(0.7)
        end
    end
    Heaven.setStatus("Peak summon attempted. Check if stand evolved.")
    heavenNotify("Peak summon done. Confirm your stand.", "Info", 5)
    return true
end

function Heaven.loopMIH()
    Heaven.StepIndex = 1
    Heaven.StepKills = 0
    local only = Heaven.OnlyStep
    if only then
        Heaven.StepIndex = 0
        for i, st in ipairs(HEAVEN_MIH_STEPS) do
            if st.name == only then Heaven.StepIndex = i break end
        end
    end
    while Heaven.Active and Heaven.Mode == "MIH" do
        if Heaven.StepIndex < 1 or Heaven.StepIndex > #HEAVEN_MIH_STEPS then
            Heaven.setStatus("All MIH NPC steps done. Talk to Pucci → Green Baby → C-Moon → corpse/DIO bone → Peak.")
            heavenNotify("MIH NPC chain finished!", "Success", 7)
            break
        end

        local step = HEAVEN_MIH_STEPS[Heaven.StepIndex]
        Heaven.setStatus(string.format(
            "MIH step %d/%d: %s %d/%d",
            Heaven.StepIndex,
            #HEAVEN_MIH_STEPS,
            step.name,
            Heaven.StepKills,
            step.target
        ))

        -- Prefer vampire area for late steps
        if step.name == "Vampire" or step.name == "Zombie Henchman" then
            local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if myRoot and (myRoot.Position - VAMPIRE_HIDEOUT).Magnitude > 120 then
                Move.goToCF(CFrame.new(VAMPIRE_HIDEOUT + Vector3.new(0, 3, 0)), Config.Teleport.Mode)
            end
        end

        local enemy = Heaven.findNpc(step.labels)
        if enemy then
            if Heaven.kill(enemy) then
                Heaven.StepKills += 1
            end
        else
            task.wait(0.8)
        end

        if Heaven.StepKills >= step.target then
            heavenNotify(step.name .. " done (" .. tostring(step.target) .. ")", "Success", 3)
            if only then
                Heaven.setStatus(step.name .. " quest step done (" .. tostring(step.target) .. ").")
                break
            end
            Heaven.StepIndex += 1
            Heaven.StepKills = 0
            task.wait(0.4)
        end
        task.wait(0.1)
    end
end

function Heaven.findOtherPlayer()
    local best, bestDist = nil, math.huge
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if char and root and hum and hum.Health > 0 then
                local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
                if dist < bestDist then
                    bestDist = dist
                    best = plr
                end
            end
        end
    end
    return best
end

function Heaven.attackPlayer(plr, timeout)
    if not plr then return false end
    timeout = tonumber(timeout) or 40
    local started = tick()
    State.NoClip = true
    while Heaven.Active and plr.Parent and tick() - started < timeout do
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local tChar = plr.Character
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not root then break end
        if not tChar or not tRoot or not tHum or tHum.Health <= 0 then
            State.NoClip = false
            return true
        end
        local behind = tRoot.CFrame * CFrame.new(0, 2, 3)
        root.CFrame = CFrame.lookAt(behind.Position, tRoot.Position)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        local remote = char:FindFirstChild("RemoteEvent")
        if remote then
            pcall(function() remote:FireServer("Attack", "m1") end)
            pcall(function()
                for _, keyName in ipairs(getgenv().AutoUseStandSkillKeys or {"E", "R", "T", "Y"}) do
                    local key = Enum.KeyCode[keyName]
                    if key then remote:FireServer("InputBegan", { Input = key }) end
                end
            end)
        end
        task.wait(0.06)
    end
    State.NoClip = false
    local tChar = plr.Character
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    return not plr.Parent or not tChar or not tHum or tHum.Health <= 0
end

function Heaven.loop1v1()
    Heaven.Wins = Heaven.Wins or 0
    Heaven.TargetWins = Heaven.TargetWins or 25
    while Heaven.Active and Heaven.Mode == "1v1" do
        Heaven.setStatus(string.format("TWOH 1v1 ~%d/%d — attack opponent", Heaven.Wins, Heaven.TargetWins))
        local enemy = Heaven.findOtherPlayer()
        if enemy then
            Heaven.setStatus("1v1 fighting @" .. enemy.Name)
            if Heaven.attackPlayer(enemy, 55) then
                Heaven.Wins += 1
                heavenNotify("1v1 target down (" .. tostring(Heaven.Wins) .. ")", "Success", 2)
                task.wait(1.2)
            end
        else
            Heaven.setStatus("1v1: join Colosseum 1v1, waiting for opponent...")
            task.wait(1)
        end
        if Heaven.Wins >= Heaven.TargetWins then
            Heaven.setStatus("1v1 target reached. Read DIO's Diary for SBR step.")
            heavenNotify("1v1 step target reached (confirm in quest).", "Success", 6)
            break
        end
        task.wait(0.15)
    end
end

function Heaven.loopSBR()
    Heaven.SBRKills = Heaven.SBRKills or 0
    Heaven.TargetSBRKills = Heaven.TargetSBRKills or 50
    local killed = {}
    while Heaven.Active and Heaven.Mode == "SBR" do
        Heaven.setStatus(string.format("TWOH SBR kills %d/%d", Heaven.SBRKills, Heaven.TargetSBRKills))
        local enemy, bestDist = nil, math.huge
        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and not killed[plr.UserId] then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if char and root and hum and hum.Health > 0 then
                    local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
                    if dist < bestDist then
                        bestDist = dist
                        enemy = plr
                    end
                end
            end
        end
        if enemy then
            Heaven.setStatus(string.format("SBR fighting @%s (%d/%d)", enemy.Name, Heaven.SBRKills, Heaven.TargetSBRKills))
            if Heaven.attackPlayer(enemy, 45) then
                killed[enemy.UserId] = true
                Heaven.SBRKills += 1
                heavenNotify("SBR kill " .. tostring(Heaven.SBRKills) .. "/" .. tostring(Heaven.TargetSBRKills), "Success", 2)
            else
                killed[enemy.UserId] = true
                task.delay(25, function() killed[enemy.UserId] = nil end)
            end
        else
            Heaven.setStatus("SBR: join Steel Ball Run match — no players nearby.")
            task.wait(1.2)
        end
        if Heaven.SBRKills >= Heaven.TargetSBRKills then
            Heaven.setStatus("SBR kills done. Diary → corpse → bone → Peak.")
            heavenNotify("SBR kill target reached.", "Success", 6)
            break
        end
        task.wait(0.12)
    end
end

function Heaven.talkNpc(patterns, label, optionName)
    Heaven.setStatus("Looking for " .. label .. "...")
    local dialogues = workspace:FindFirstChild("Dialogues")
    local npc = nil
    if dialogues then
        for _, child in ipairs(dialogues:GetDescendants()) do
            local n = string.lower(child.Name)
            for _, pat in ipairs(patterns) do
                if string.find(n, pat, 1, true) and (child:IsA("Model") or child:IsA("BasePart")) then
                    npc = child
                    break
                end
            end
            if npc then break end
        end
    end
    if not npc then
        Heaven.setStatus(label .. " not found in workspace.Dialogues.")
        return false
    end
    local part = npc:IsA("BasePart") and npc or npc:FindFirstChildWhichIsA("BasePart", true)
    if part then
        Move.goToCF(CFrame.new(part.Position + Vector3.new(0, 3, 3)), Config.Teleport.Mode)
    end
    local character = LP.Character
    local remote = character and character:FindFirstChild("RemoteEvent")
    local dialogueFolder = ReplicatedStorage:FindFirstChild("Dialogue")
    local dialogueNameObj = npc:FindFirstChild("Dialogue")
    local dialogueName = dialogueNameObj and tostring(dialogueNameObj.Value or "") or npc.Name
    local template = dialogueFolder and (dialogueFolder:FindFirstChild(dialogueName) or dialogueFolder:FindFirstChild(npc.Name))
    if remote and template then
        pcall(function() remote:FireServer("PromptTriggered", template) end)
    elseif remote then
        pcall(function()
            remote:FireServer("DialogueInteracted", { DialogueName = dialogueName, Speaker = npc.Name })
        end)
    end
    local gui = Gui.waitDialogue(4)
    if not gui then
        Heaven.setStatus(label .. " dialogue did not open.")
        return false
    end
    if optionName then
        Gui.waitAndClickOption(optionName, 5)
    else
        Gui.oneClick()
    end
    task.wait(0.25)
    pcall(function() Gui.advanceUntilClosed(6) end)
    Heaven.setStatus(label .. " dialogue done.")
    return true
end

-- DD full chain (start → finish):
-- 1) Stone Free  2) Pucci x2  3) Anasui  4) Friendly Jotaro
-- 5) Complete active quest objectives (kill matching NPCs / re-talk)
-- 6) Confirm Diver Down equipped
function Heaven.hasDiverDown()
    local name = string.lower(Heaven.standName())
    return string.find(name, "diver down", 1, true) ~= nil
end

function Heaven.hasStoneFree()
    local name = string.lower(Heaven.standName())
    return name == "stone free" or string.find(name, "stone free", 1, true) ~= nil
end

function Heaven.currentQuestText()
    local quest = Utils.stat(LP, "Quest") or ""
    local stats = LP:FindFirstChild("PlayerStats")
    if stats then
        local q = stats:FindFirstChild("Quest")
        if q then quest = tostring(q.Value or quest) end
    end
    return tostring(quest or "")
end

function Heaven.ddStoneFree()
    if Heaven.hasDiverDown() then
        Heaven.setStatus("Already have Diver Down.")
        return true
    end
    if Heaven.hasStoneFree() then
        Heaven.setStatus("Stone Free already equipped.")
        return true
    end
    Heaven.setStatus("DD 1/6: Rolling for Stone Free...")
    State.StandFarmSelected = {"Stone Free"}
    pcall(function() SettingsStore.markDirty() end)
    if not State.StandFarm then StandFarm.start() end
    local started = tick()
    while Heaven.Active do
        if Heaven.hasStoneFree() or Heaven.hasDiverDown() then
            pcall(function() StandFarm.stop("Stone Free obtained.") end)
            heavenNotify("Stone Free obtained!", "Success", 5)
            return true
        end
        if tick() - started > 900 then
            Heaven.setStatus("Stone Free roll timed out (15 min).")
            break
        end
        task.wait(1)
    end
    pcall(function() StandFarm.stop("Stopped.") end)
    return Heaven.hasStoneFree() or Heaven.hasDiverDown()
end

function Heaven.ddPucci()
    if Heaven.hasDiverDown() then return true end
    Heaven.setStatus("DD 2/6: Talking to Pucci (dialogue 1/2)...")
    if not Heaven.talkPucci() then return false end
    -- second dialogue window
    Heaven.setStatus("DD 2/6: Pucci dialogue 2/2...")
    task.wait(0.4)
    local gui = Gui.waitDialogue(5)
    if gui then
        Gui.oneClick()
        task.wait(0.25)
        pcall(function() Gui.advanceUntilClosed(6) end)
    else
        -- try re-open Pucci for second window
        pcall(function() Heaven.talkPucci() end)
        gui = Gui.waitDialogue(4)
        if gui then
            Gui.oneClick()
            task.wait(0.25)
            pcall(function() Gui.advanceUntilClosed(6) end)
        end
    end
    Heaven.setStatus("DD 2/6: Pucci done.")
    return true
end

function Heaven.ddAnasui()
    if Heaven.hasDiverDown() then return true end
    Heaven.setStatus("DD 3/6: Talking to Anasui...")
    return Heaven.talkNpc({"anasui", "narciso"}, "Anasui", "Option1")
