local Gui = {}

function Gui.isVisible(guiObject)
    if not guiObject or not guiObject:IsA("GuiObject") or not guiObject.Visible then
        return false
    end
    local current = guiObject.Parent
    while current do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end
        if current:IsA("ScreenGui") and not current.Enabled then
            return false
        end
        current = current.Parent
    end
    return true
end

-- Screen click helpers (resolution-aware, multi-method for different executors).
function Gui.screenSize()
    local camera = workspace.CurrentCamera
    if camera and camera.ViewportSize.X > 0 and camera.ViewportSize.Y > 0 then
        return camera.ViewportSize
    end
    return Vector2.new(1920, 1080)
end

function Gui.resolveClickPoint(x, y, asNormalized)
    local size = Gui.screenSize()
    local px, py = tonumber(x) or 0, tonumber(y) or 0
    if asNormalized == true then
        px = px * size.X
        py = py * size.Y
    end
    return px, py, size
end

-- True if the Roblox client window is focused (best-effort; many executors expose this).
function Gui.isGameFocused()
    local focused = true
    pcall(function()
        if type(isrbxactive) == "function" then
            focused = isrbxactive() == true
            return
        end
        if type(iswindowactive) == "function" then
            focused = iswindowactive() == true
            return
        end
        if type(iswindowactive) == "boolean" then
            focused = iswindowactive
            return
        end
        -- UserInputService: WindowFocused is not always exposed; try GetFocusedTextBox path is useless.
        -- Assume focused if unknown so we still attempt all methods.
        focused = true
    end)
    return focused == true
end

-- Fire a click at pixel (px, py).
-- When the window is minimized / unfocused, ONLY VirtualInputManager is reliable
-- (OS mouse APIs click the wrong window). VIM injects into the Roblox client itself.
function Gui.clickAtRaw(px, py)
    px, py = tonumber(px) or 0, tonumber(py) or 0
    local any = false
    local focused = Gui.isGameFocused()

    -- VirtualInputManager: one clean click (no spam — spam skips Yes / advances dialogue twice)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local insetY = 0
        pcall(function()
            insetY = game:GetService("GuiService"):GetGuiInset().Y
        end)
        -- Prefer plain coords; only try inset offset if primary fails later
        local x, y = px, py
        pcall(function() vim:SendMouseMoveEvent(x, y, game) end)
        task.wait(0.02)
        vim:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.04)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 1)
        any = true
        -- one optional inset-adjusted click after a pause (not a rapid double-tap)
        if insetY ~= 0 then
            task.wait(0.12)
            local y2 = py + insetY
            pcall(function() vim:SendMouseMoveEvent(x, y2, game) end)
            task.wait(0.02)
            vim:SendMouseButtonEvent(x, y2, 0, true, game, 1)
            task.wait(0.04)
            vim:SendMouseButtonEvent(x, y2, 0, false, game, 1)
        end
    end)

    -- OS-level mouse only when the game is focused (useless / harmful when minimized)
    if focused then
        pcall(function()
            if type(mousemoveabs) == "function" then
                mousemoveabs(px, py)
                task.wait(0.02)
            end
            if type(mouse1press) == "function" and type(mouse1release) == "function" then
                mouse1press()
                task.wait(0.03)
                mouse1release()
                any = true
            elseif type(mouse1click) == "function" then
                mouse1click()
                any = true
            end
        end)

        pcall(function()
            if type(mousemoverel) == "function" and type(mouse1click) == "function" then
                local mousePos = UserInputService:GetMouseLocation()
                mousemoverel(px - mousePos.X, py - mousePos.Y)
                task.wait(0.02)
                mouse1click()
                any = true
            end
        end)

        pcall(function()
            if type(syn) == "table" and type(syn.mouse_click) == "function" then
                syn.mouse_click(px, py)
                any = true
            end
        end)
    end

    return any
end

function Gui.clickAt(x, y, asNormalized)
    local px, py = Gui.resolveClickPoint(x, y, asNormalized)
    return Gui.clickAtRaw(px, py)
end

function Gui.clickNormalized(nx, ny)
    return Gui.clickAt(nx, ny, true)
end

function Gui.clickAtScaled(x, y, baseW, baseH)
    local size = Gui.screenSize()
    baseW = tonumber(baseW) or 1920
    baseH = tonumber(baseH) or 1080
    if baseW <= 0 then baseW = 1920 end
    if baseH <= 0 then baseH = 1080 end
    local px = (tonumber(x) or 0) / baseW * size.X
    local py = (tonumber(y) or 0) / baseH * size.Y
    return Gui.clickAtRaw(px, py)
end

-- Main auto-click entry: scaled + raw retries so it works on more setups.
function Gui.farmStartClick()
    local cfg = Config and Config.FarmStartClick
    if not cfg or cfg.Enabled ~= true then
        warn("[Methion] Auto Click skipped: FarmStartClick disabled")
        return false
    end
    local delay = tonumber(cfg.Delay) or 0.15
    if delay > 0 then task.wait(delay) end

    local x = tonumber(cfg.X) or 1241
    local y = tonumber(cfg.Y) or 695
    local baseW = tonumber(cfg.BaseW) or 1920
    local baseH = tonumber(cfg.BaseH) or 1080
    local size = Gui.screenSize()
    local scaledX = x / baseW * size.X
    local scaledY = y / baseH * size.Y

    local ok = false
    -- One scaled click only (spam was skipping Yes / double-advancing dialogue)
    if Gui.clickAtRaw(scaledX, scaledY) then
        ok = true
    end
    -- If that failed and screen size differs from base, try raw once after a pause
    if not ok and (size.X ~= baseW or size.Y ~= baseH) then
        task.wait(0.2)
        if Gui.clickAtRaw(x, y) then
            ok = true
        end
    end

    print(string.format(
        "[Methion] Auto Click → scaled (%.0f, %.0f) on %dx%d | raw (%d, %d) | focused=%s | ok=%s",
        scaledX, scaledY, size.X, size.Y, x, y, tostring(Gui.isGameFocused()), tostring(ok)
    ))
    return ok
end

function Gui.dialogueSignature(gui)
    if not gui or not gui.Parent then return "" end
    local parts = {}
    for _, obj in ipairs(gui:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and Gui.isVisible(obj) then
            table.insert(parts, obj:GetFullName() .. "=" .. tostring(obj.Text))
        end
    end
    table.sort(parts)
    return table.concat(parts, "\30")
end

function Gui.dialogueText(gui)
    if not gui or not gui.Parent then return "" end
    local parts = {}
    local frame = gui:FindFirstChild("Frame")
    local options = frame and frame:FindFirstChild("Options")
    for _, obj in ipairs(gui:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton"))
            and Gui.isVisible(obj)
            and not (options and obj:IsDescendantOf(options)) then
            local value = tostring(obj.Text or "")
            if value ~= "" then table.insert(parts, value) end
        end
    end
    return table.concat(parts, " ")
end

function Gui.hasCombatDialogueWarning(gui)
    local text = string.lower(Gui.dialogueText(gui))
    if text == "" then return false end
    if text:find("pay attention to your fight", 1, true) then return true end
    if text:find("pay attention", 1, true) and text:match("%f[%a]fight%f[%A]") then return true end
    if text:match("%f[%a]fight%f[%A]") then return true end
    return false
end

