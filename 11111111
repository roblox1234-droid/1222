    LastClickAt = 0,
    MinInterval = 0.12,
    RetryAfter = 1.0,
    Retries = 0,
    MaxRetries = 3,
    Busy = false,
}

function DialogueOneClick.shouldHandle()
    if State.AutoDialogueOneClick ~= true then return false end
    -- Do not interfere with sell / stand-farm dialogue sequences.
    if State.Selling == true or State.StandFarmBusy == true then return false end
    return true
end

function DialogueOneClick.tryClick()
    if not DialogueOneClick.shouldHandle() then return false end
    if DialogueOneClick.Busy then return false end

    local gui = Gui.currentDialogue()
    if not gui then
        DialogueOneClick.LastSignature = ""
        return false
    end

    local signature = Gui.dialogueSignature(gui)
    if type(signature) ~= "string" or signature == "" then
        signature = tostring(gui) .. ":" .. tostring(tick())
    end

    local now = tick()
    local sameState = signature == DialogueOneClick.LastSignature
    if sameState then
        -- Already handled this state; only retry if the click did not advance it (stuck dialogue).
        if now - DialogueOneClick.LastClickAt < DialogueOneClick.RetryAfter
            or DialogueOneClick.Retries >= DialogueOneClick.MaxRetries then
            return false
        end
        DialogueOneClick.Retries += 1
    else
        DialogueOneClick.Retries = 0
    end

    if now - DialogueOneClick.LastClickAt < DialogueOneClick.MinInterval then
        return false
    end

    DialogueOneClick.Busy = true
    DialogueOneClick.LastSignature = signature
    DialogueOneClick.LastClickAt = now

    local ok, clicked = pcall(function()
        return Gui.oneClick() == true
    end)

    DialogueOneClick.Busy = false
    return ok and clicked == true
end

function Gui.hardCloseDialogue()
    local gui = Gui.currentDialogue()
    if not gui then return true end

    -- Try normal close buttons first
    for _, descendant in ipairs(gui:GetDescendants()) do
        if descendant:IsA("GuiButton") and Gui.isVisible(descendant) then
            local buttonName = string.lower(tostring(descendant.Name or "")):gsub("[%s%p]", "")
            local buttonText = string.lower(tostring(descendant.Text or "")):gsub("[%s%p]", "")
            local isClose = buttonName == "close" or buttonName == "closebutton"
                or buttonName == "exit" or buttonName == "exitbutton"
                or buttonName == "x" or buttonName == "xbutton"
                or buttonName == "skip" or buttonName == "skipbutton"
                or buttonText == "close" or buttonText == "exit"
                or buttonText == "x" or buttonText == "×" or buttonText == "skip"
            if isClose then
                Gui.click(descendant)
            end
        end
    end

    -- Force hide
    pcall(function()
        local frame = gui:FindFirstChild("Frame")
        if frame and frame:IsA("GuiObject") then
            frame.Visible = false
        end
        if gui:IsA("ScreenGui") then
            gui.Enabled = false
        elseif gui:IsA("GuiObject") then
            gui.Visible = false
        end
    end)

    return Gui.currentDialogue() == nil
end

function Gui.skipClick()
    local gui = Gui.currentDialogue()
    if not gui then return false end

    -- Never skip while choice options are visible (Yes/No, quest options, etc.)
    if Gui.hasVisibleOptions(gui) then
        return false
    end

    -- Only click real Skip / Continue buttons — no corner spam
    local frame = gui:FindFirstChild("Frame")
    local options = frame and frame:FindFirstChild("Options")

    for _, descendant in ipairs(gui:GetDescendants()) do
        if descendant:IsA("GuiButton") and Gui.isVisible(descendant)
            and not (options and descendant:IsDescendantOf(options)) then
            local buttonName = string.lower(tostring(descendant.Name or "")):gsub("[%s%p]", "")
            local buttonText = string.lower(tostring(descendant.Text or "")):gsub("[%s%p]", "")
            local isSkip = buttonName:find("skip", 1, true)
                or buttonName:find("continue", 1, true)
                or buttonName:find("advance", 1, true)
                or buttonName == "next"
                or buttonText:find("skip", 1, true)
                or buttonText:find("continue", 1, true)
                or buttonText:find("advance", 1, true)
                or buttonText == "next"
            if isSkip then
                if Gui.click(descendant) then
                    return true
                end
            end
        end
    end

    return false
end

function Gui.click(button)
    if not button or not button.Parent then return false end

    local fired = false
    -- Each signal is fired exactly once (firesignal first, getconnections only as a fallback).
    -- Firing the same handler twice made lines advance twice and get skipped.
    local function fireSignal(signal)
        if not signal then return false end
        local done = false
        if type(firesignal) == "function" then
            done = pcall(function()
                firesignal(signal)
            end)
        end
        if not done and type(getconnections) == "function" then
            local ok, connections = pcall(function()
                return getconnections(signal)
            end)
            if ok and connections then
                for _, connection in pairs(connections) do
                    local success = pcall(function()
                        if connection.Fire then
                            connection:Fire()
                        elseif connection.Function then
                            connection.Function()
                        end
                    end)
                    if success then done = true end
                end
            end
        end
        if done then fired = true end
        return done
    end

    -- One clean click path: Click + Activated (no spam loops)
    fireSignal(button.MouseButton1Click)
    fireSignal(button.MouseButton1Down)
    fireSignal(button.Activated)
    pcall(function()
        if button.Activate then button:Activate() end
    end)

    if fired then return true end

    -- Fallback: physical screen click at button center.
    -- AbsolutePosition is top-left of the GUI object in pixels for the current resolution;
    -- adding GuiInset.Y makes VirtualInputManager line up on every screen size / inset.
    local pos = button.AbsolutePosition
    local size = button.AbsoluteSize
    if size.X > 0 and size.Y > 0 then
        local insetY = 0
        pcall(function()
            insetY = game:GetService("GuiService"):GetGuiInset().Y
        end)
        local cx = pos.X + size.X * 0.5
        local cy = pos.Y + size.Y * 0.5 + insetY
        return Gui.clickAt(cx, cy, false)
    end
    return false
end

function Gui.isMistaDialogue(gui)
    if not gui then return false end
    local blob = string.lower(tostring(Gui.dialogueText(gui) or ""))
    pcall(function()
        for _, obj in ipairs(gui:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                blob = blob .. " " .. string.lower(tostring(obj.Text or ""))
            end
        end
    end)
    return string.find(blob, "mista", 1, true) ~= nil
        or string.find(blob, "guido", 1, true) ~= nil
        or string.find(blob, "sex pistol", 1, true) ~= nil
end

function Gui.optionButtonText(button)
    if not button then return "" end
    local parts = {tostring(button.Text or "")}
    pcall(function()
        for _, d in ipairs(button:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                local t = tostring(d.Text or "")
                if t ~= "" then table.insert(parts, t) end
            end
        end
    end)
    return string.lower(table.concat(parts, " "))
end

-- Score dialogue options by text (works for Mista + general storyline)
function Gui.scoreOptionForStory(text, ctx)
    ctx = ctx or {}
    text = string.lower(tostring(text or ""))
    local score = 0
    local positive = {
        "accept", "take", "help", "yes", "sure", "okay", "ok", "quest", "start", "begin",
        "continue", "next", "ready", "do it", "alright", "of course", "go on", "tell me",
        "what do you need", "i'll help", "ill help", "fine", "deal", "agree",
        "turn in", "complete", "finished", "reward", "claim", "deliver", "hand over", "done",
    }
    local negative = {
        "no thanks", "not now", "don't", "do not", "decline", "cancel", "leave", "later",
        "never mind", "nevermind", "goodbye", "good bye", "no,", " nah", "refuse", "walk away",
    }
    for _, w in ipairs(positive) do
        if string.find(text, w, 1, true) then score += 3 end
    end
    for _, w in ipairs(negative) do
        if string.find(text, w, 1, true) then score -= 8 end
    end

    -- Mista hates the number 4 — avoid options that push "4" as a choice answer
    if ctx.isMista then
        if string.find(text, "four", 1, true) or text:match("%f[%d]4%f[%D]") then
            score -= 6
        end
        if string.find(text, "pistols", 1, true) or string.find(text, "sex pistol", 1, true) then
            score += 2
        end
        if string.find(text, "help", 1, true) or string.find(text, "quest", 1, true) then
            score += 2
        end
    end

    if ctx.preferredName and ctx.optionName == ctx.preferredName then
        score += 1
    end
    return score
end

-- Pick best visible option; never random-skip when options exist
function Gui.pickBestOption(gui, preferredName)
    if not gui then return nil, nil end
    local isMista = Gui.isMistaDialogue(gui)
    local bestName, bestBtn, bestScore = nil, nil, -1e9
    local firstName, firstBtn = nil, nil

    for i = 1, 8 do
        local name = "Option" .. tostring(i)
        local btn = Gui.option(gui, name)
        if btn and btn.Parent and Gui.isVisible(btn) then
            if not firstBtn then
                firstName, firstBtn = name, btn
            end
            local text = Gui.optionButtonText(btn)
            local score = Gui.scoreOptionForStory(text, {
                isMista = isMista,
                preferredName = preferredName,
                optionName = name,
            })
            if score > bestScore then
                bestScore = score
                bestName, bestBtn = name, btn
            end
        end
    end

    -- Prefer preferred option only if its score is not negative
    if preferredName then
        local pref = Gui.option(gui, preferredName)
        if pref and Gui.isVisible(pref) then
            local prefScore = Gui.scoreOptionForStory(Gui.optionButtonText(pref), {
                isMista = isMista,
                preferredName = preferredName,
                optionName = preferredName,
            })
            if prefScore >= 0 and (not bestBtn or prefScore >= bestScore - 1) then
                return preferredName, pref
            end
        end
    end

    if bestBtn and bestScore >= 0 then
        return bestName, bestBtn
    end
    -- last resort: first visible option (still better than skip)
    return firstName, firstBtn
end

-- Single dialogue step: Option1 by default; Mista always uses Option2.
function Gui.oneClick()
    local gui = Gui.currentDialogue()
    if not gui then return false end

    if Gui.hasVisibleOptions(gui) then
        -- Mista quest/dialogue requires the 2nd choice
        if Gui.isMistaDialogue(gui) then
            local option2 = Gui.option(gui, "Option2")
            if option2 and Gui.isVisible(option2) then
                return Gui.click(option2)
            end
        end
        local option1 = Gui.option(gui, "Option1")
        if option1 and Gui.isVisible(option1) then
            return Gui.click(option1)
        end
        for _, name in ipairs({"Option2", "Option3", "Option4"}) do
            local opt = Gui.option(gui, name)
            if opt and Gui.isVisible(opt) then
                return Gui.click(opt)
            end
        end
        return false
    end

    return Gui.skipClick()
end

function Gui.dialogueActive(gui)
    if not gui or not gui.Parent then return false end
    if gui:IsA("ScreenGui") and not gui.Enabled then return false end
    if gui:IsA("GuiObject") and not gui.Visible then return false end
    local frame = gui:FindFirstChild("Frame")
    if frame and frame:IsA("GuiObject") and not frame.Visible then return false end
    return true
end

function Gui.currentDialogue()
    local playerGui = LP:FindFirstChildOfClass("PlayerGui") or LP:FindFirstChild("PlayerGui")
    local gui = playerGui and playerGui:FindFirstChild("DialogueGui") or nil
    return Gui.dialogueActive(gui) and gui or nil
end

function Gui.option(gui, name)
    local frame = gui and gui:FindFirstChild("Frame")
    if not frame then return nil end
    local options = frame:FindFirstChild("Options")
    if not options then return nil end

    local option = options:FindFirstChild(name) or options:FindFirstChild(name, true)
    if not option then return nil end
    if option:IsA("GuiButton") then return option end
    return option:FindFirstChildWhichIsA("GuiButton", true)
end

function Gui.hasVisibleOptions(gui)
    local frame = gui and gui:FindFirstChild("Frame")
    local options = frame and frame:FindFirstChild("Options")
    if not options or not Gui.isVisible(options) then return false end

    for _, name in ipairs({"Option1", "Option2", "Option3", "Option4", "Option5", "Option6", "Option7", "Option8"}) do
        local button = Gui.option(gui, name)
        if button and Gui.isVisible(button) then
            return true
        end
    end

    for _, descendant in ipairs(options:GetDescendants()) do
        if descendant:IsA("GuiButton") and Gui.isVisible(descendant) then
            return true
        end
    end
    for _, child in ipairs(options:GetChildren()) do
        if child:IsA("GuiButton") and Gui.isVisible(child) then
            return true
        end
    end
    return false
end

-- Fast but safe line skipping: click again as soon as the line changed (min interval),
-- or retry after a longer pause if nothing changed (stuck line). Never clicks over choices.
Gui.SkipMinInterval = 0.1
Gui.SkipRetryInterval = 0.5

function Gui.smartSkip(state)
    local gui = Gui.currentDialogue()
    if not gui or Gui.hasVisibleOptions(gui) then return false end
    local now = tick()
    local since = now - (state.lastSkip or 0)
    if since < Gui.SkipMinInterval then return false end
    local signature = Gui.dialogueSignature(gui)
    if signature == state.lastSig and since < Gui.SkipRetryInterval then return false end
    if Gui.skipClick() then
        state.lastSkip = tick()
        state.lastSig = signature
        return true
    end
    return false
end

function Gui.waitDialogue(timeout)
    local start = tick()
    while tick() - start < timeout do
        local gui = Gui.currentDialogue()
        if gui and gui.Parent then return gui end
        task.wait()
    end
    return nil
end

function Gui.waitAndClickOption(name, timeout)
    local started = tick()
    local skipState = {lastSkip = 0, lastSig = nil}
    local clickedOption = false

    while tick() - started < timeout do
        local gui = Gui.currentDialogue()
        if not gui then
            task.wait(0.05)
            gui = Gui.currentDialogue()
            if not gui then
                return clickedOption
            end
        end

        local target = Gui.option(gui, name)
        if target and target.Parent and Gui.isVisible(target) then
            -- Exactly one click on the option, then wait for dialogue to change
            if Gui.click(target) then
                clickedOption = true
                local sig = Gui.dialogueSignature(gui)
                local waitUntil = tick() + 0.8
                while tick() < waitUntil do
                    local nowGui = Gui.currentDialogue()
                    if not nowGui then return true end
                    if Gui.dialogueSignature(nowGui) ~= sig then return true end
                    if not Gui.option(nowGui, name) then return true end
                    task.wait(0.02)
                end
                return true
            end
        elseif not Gui.hasVisibleOptions(gui) then
            Gui.smartSkip(skipState)
        end

        task.wait(0.02)
    end

    return clickedOption
end

function Gui.advanceUntilClosed(timeout)
    local started = tick()
    local skipState = {lastSkip = 0, lastSig = nil}

    while tick() - started < timeout do
        local gui = Gui.currentDialogue()
        if not gui or not Gui.dialogueActive(gui) then
            return true
        end

        if not Gui.hasVisibleOptions(gui) then
            Gui.smartSkip(skipState)
        end

        task.wait(0.02)
    end

    return Gui.currentDialogue() == nil
end

function Gui.forceCloseDialogue(timeout)
    local deadline = tick() + (tonumber(timeout) or 3)
    local forceState = {lastSkip = 0, lastSig = nil}

    while tick() < deadline do
        local gui = Gui.currentDialogue()
        if not gui then return true end

        -- Prefer real close/skip buttons only
        local clickedClose = false
        for _, descendant in ipairs(gui:GetDescendants()) do
            if descendant:IsA("GuiButton") and Gui.isVisible(descendant) then
                local buttonName = string.lower(tostring(descendant.Name or "")):gsub("[%s%p]", "")
                local buttonText = string.lower(tostring(descendant.Text or "")):gsub("[%s%p]", "")
                local isCloseButton = buttonName == "close" or buttonName == "closebutton"
                    or buttonName == "exit" or buttonName == "exitbutton"
                    or buttonName == "x" or buttonName == "xbutton"
                    or buttonName == "skip" or buttonName == "skipbutton"
                    or buttonText == "close" or buttonText == "exit"
                    or buttonText == "x" or buttonText == "×" or buttonText == "skip"
                if isCloseButton and Gui.click(descendant) then
                    clickedClose = true
                    break
                end
            end
        end

        if not clickedClose and not Gui.hasVisibleOptions(gui) then
            Gui.smartSkip(forceState)
        end
        task.wait(0.03)
    end

    -- Last resort only if still open and no options
    local remaining = Gui.currentDialogue()
    if remaining and not Gui.hasVisibleOptions(remaining) then
        return Gui.hardCloseDialogue()
    end
    return Gui.currentDialogue() == nil
end

function Gui.fastSkip(timeout)
    timeout = tonumber(timeout) or 3
    local started = tick()
    local skipState = {lastSkip = 0, lastSig = nil}

    while tick() - started < timeout do
        local gui = Gui.currentDialogue()
        if not gui or not Gui.dialogueActive(gui) then
            return true
        end

        -- Never touch choice dialogues
        if Gui.hasVisibleOptions(gui) then
            return false
        end

        Gui.smartSkip(skipState)

        task.wait(0.02)
    end

    return Gui.currentDialogue() == nil
end

local ItemESP = {}

function ItemESP.isPlayerOwned(obj, part)
    local candidates = {part, obj}
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local backpack = player:FindFirstChild("Backpack")
        for _, candidate in ipairs(candidates) do
            if candidate and candidate.Parent then
                if character and candidate:IsDescendantOf(character) then
                    return true
                end
                if backpack and candidate:IsDescendantOf(backpack) then
                    return true
                end
            end
        end
    end
    return false
end

function ItemESP.colorFor(name)
    if Config.Esp.ItemUseTypeColors and ESP_ITEMS[name] then
        return ESP_ITEMS[name]
    end
    return Config.Esp.ItemHighlightColor or ESP_ITEMS[name] or Color3.fromRGB(255, 185, 46)
end

function ItemESP.labelText(part, name)
    local text = tostring(name or "Item")
    if Config.Esp.ShowItemDistance then
        local character = LP.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root and part and part.Parent then
            text ..= "\n" .. tostring(math.floor((part.Position - root.Position).Magnitude)) .. " studs away"
        end
    end
    return text
end

function ItemESP.create(part, name, visible)
    if not part or not part.Parent then return end
    if ItemESP.isPlayerOwned(nil, part) then
        local existingHighlight = part:FindFirstChild("Phantom_ESP")
        local existingLabel = part:FindFirstChild("Phantom_Label")
        if existingHighlight then existingHighlight.Enabled = false end
        if existingLabel then existingLabel.Enabled = false end
        return
    end
    local color = ItemESP.colorFor(name)
    local shouldShow = visible == true and State.ItemEsp == true
    local hl = part:FindFirstChild("Phantom_ESP")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "Phantom_ESP"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = part
        hl.Parent = part
    end
    hl.Adornee = part
    hl.FillColor = color
    hl.OutlineColor = Config.Esp.ItemOutlineColor
    hl.FillTransparency = shouldShow and math.clamp(tonumber(Config.Esp.ItemFillTransparency) or 0.45, 0, 1) or 1
    hl.OutlineTransparency = shouldShow and math.clamp(tonumber(Config.Esp.ItemOutlineTransparency) or 0, 0, 1) or 1
    hl.Enabled = shouldShow

    local bb = part:FindFirstChild("Phantom_Label")
    if not bb then
        bb = Instance.new("BillboardGui")
        bb.Name = "Phantom_Label"
        bb.Size = UDim2.new(0, 170, 0, 44)
        bb.AlwaysOnTop = true
        bb.MaxDistance = 4000
        bb.StudsOffset = Vector3.new(0, 3, 0)
        bb.Adornee = part
        bb.Parent = part
    end
    bb.Adornee = part
    local label = bb:FindFirstChild("Phantom_Text")
    if not label then
        label = Instance.new("TextLabel")
        label.Name = "Phantom_Text"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamMedium
        label.Parent = bb
    end
    label.TextColor3 = Config.Esp.ItemNameColor
    label.TextSize = math.clamp(math.floor(tonumber(Config.Esp.ItemTextSize) or 13), 8, 24)
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency = 0.25
    label.TextWrapped = true
    label.Text = ItemESP.labelText(part, name)
    bb.Enabled = shouldShow
end

function ItemESP.remove(part)
    if not part then return end
    local hl = part:FindFirstChild("Phantom_ESP")
    if hl then hl:Destroy() end
    local bb = part:FindFirstChild("Phantom_Label")
    if bb then bb:Destroy() end
end

function ItemESP.refresh()
    for part, data in pairs(Tracked) do
        if part and part.Parent and part:IsDescendantOf(workspace) then
            if not Utils.invisible(part) and not ItemESP.isPlayerOwned(data.Obj, part) then
                ItemESP.create(part, data.Name, State.ItemEsp)
            else
                local hl = part:FindFirstChild("Phantom_ESP")
                local bb = part:FindFirstChild("Phantom_Label")
                if hl then hl.Enabled = false end
                if bb then bb.Enabled = false end
            end
        end
    end
end

function ItemESP.setVisible(visible)
    State.ItemEsp = visible == true
    ItemESP.refresh()
end

function ItemESP.register(obj)
    if not obj or TrackedRev[obj] then return end
    local name, part
    if obj:IsA("ProximityPrompt") and ESP_ITEMS[obj.ObjectText or ""] then
        name = obj.ObjectText
        part = Utils.basePart(obj)
    elseif obj:IsA("BasePart") and ESP_ITEMS[obj.Name] then
        name = obj.Name
        part = obj
    end
    if not name or not part then return end
    if Tracked[part] then TrackedRev[obj] = part return end
    if not Utils.validPos(part) then
        table.insert(Pending, {obj = obj, part = part, name = name})
        return
    end
    if not Utils.invisible(part) then ItemESP.create(part, name, State.ItemEsp) end
    Tracked[part] = {Name = name, Obj = obj}
    TrackedRev[obj] = part
end

function ItemESP.unregister(part)
    if not part then return end
    if Tracked[part] then
        ItemESP.remove(part)
        Tracked[part] = nil
    end

    for object, mappedPart in pairs(TrackedRev) do
        if mappedPart == part then
            TrackedRev[object] = nil
        end
    end

    for index = #Pending, 1, -1 do
        local entry = Pending[index]
        if entry and entry.part == part then
            table.remove(Pending, index)
        end
    end
end

function ItemESP.scan()
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("ProximityPrompt") or o:IsA("BasePart") then
            ItemESP.register(o)
        end
    end
end

function ItemESP.count()
    local n = 0
    for part, data in pairs(Tracked) do
        if part and part:IsDescendantOf(workspace) and not Utils.invisible(part)
            and not ItemESP.isPlayerOwned(data and data.Obj, part) then
            n = n + 1
        end
    end
    return n
end

local PlayerESP = {}

function PlayerESP.create(char, name, visible)
    if not char or not char.Parent then return end
    local head = char:FindFirstChild("Head")
