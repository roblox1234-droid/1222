-- ============================================================
-- CDR Quest (Crazy Diamond Requiem)
-- Steps: talk to Suno -> heal 3000 (manual/other players) ->
-- kill 40 criminals -> kill 25 villain players (manual) ->
-- kill Yoshikage Kira -> use Requiem Arrow.
-- ============================================================
do
local CDRTab = Window:Tab({
    Title = "CDR Quest",
    Icon = "gem",
    Desc = "Auto helpers for Crazy Diamond Requiem questline.",
})

local CDR = {
    Active = false,
    Mode = "Criminals", -- Criminals | Kira | Suno | Villains
    StatusLabel = nil,
    Kills = 0,
    TargetKills = 40,
    VillainKills = 0,
    VillainTarget = 25,
    Session = 0,
    KilledVillains = {}, -- [userId] = true for this session
    AutoHop = true,
    HopWaitSeconds = 8, -- no targets for this long -> hop
    HopBusy = false,
    LastHop = 0,
}

local CDR_CRIMINALS = {
    "Thug", "Alpha Thug", "Corrupt Police", "Zombie Henchman", "Vampire",
}
local CDR_KIRA_NAMES = {
    "Yoshikage Kira", "Kira", "Yoshikage",
}
-- Villain / antagonistic stands for the "25 villain stand players" step
local CDR_VILLAIN_STANDS = {
    "the world",
    "the world over heaven",
    "the world alternate universe",
    "shadow the world",
    "killer queen",
    "killer queen bites the dust",
    "made in heaven",
    "king crimson",
    "king crimson requiem",
    "d4c",
    "d4c love train",
    "dirty deeds done dirt cheap",
    "whitesnake",
    "cream",
    "c-moon",
    "c moon",
    "dios",
    "dio",
    "heaven ascension",
}
local CDR_MERCHANT_KEEP = Config.Teleport.Locations["Merchant's Keep"]
    or Vector3.new(-620.4, -25.8, -465.1)

local function cdrNotify(content, kind, duration)
    pcall(function()
        Window:Notify({
            Title = "CDR Quest",
            Content = content,
            Type = kind or "Info",
            Duration = duration or 4,
        })
    end)
end

function CDR.setStatus(text)
    if CDR.StatusLabel and type(CDR.StatusLabel.SetDesc) == "function" then
        pcall(function() CDR.StatusLabel:SetDesc(tostring(text)) end)
    end
end

function CDR.hasCrazyDiamond()
    local name = string.lower(tostring(Utils.stat(LP, "Stand") or ""))
    local stats = LP:FindFirstChild("PlayerStats")
    local stand = stats and stats:FindFirstChild("Stand")
    if stand then name = string.lower(tostring(stand.Value or "")) end
    return string.find(name, "crazy diamond", 1, true) ~= nil
end

function CDR.findEnemyByNames(nameList)
    local living = workspace:FindFirstChild("Living")
    local containers = {}
    if living then table.insert(containers, living) end
    local mob2 = workspace:FindFirstChild("Mob_Spawns2")
    if mob2 then table.insert(containers, mob2) end
    table.insert(containers, workspace)

    local function matchName(instName)
        local lower = string.lower(tostring(instName or ""))
        for _, wanted in ipairs(nameList) do
            local w = string.lower(wanted)
            if lower == w or string.find(lower, w, 1, true) then return true end
        end
        return false
    end

    for _, container in ipairs(containers) do
        for _, child in ipairs(container:GetChildren()) do
            if matchName(child.Name) then
                local h = child:FindFirstChild("Health")
                local hrp = child:FindFirstChild("HumanoidRootPart")
                if hrp and ((h and tonumber(h.Value) and h.Value > 0) or not h) then
                    local hum = child:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health > 0 then
                        return child
                    end
                end
            end
        end
    end
    return nil
end

function CDR.killTarget(enemy)
    if not enemy or not enemy.Parent then return false end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
    if not root or not enemyRoot then return false end

    local started = tick()
    State.NoClip = true
    CDR.forceNoclip()
    -- Approach with fly, then stick + pilot
    pcall(function()
        local goal = CDR.goalBehind(enemyRoot, 0.35, 0.35)
        CDR.flyOrSnapTo(goal, function()
            return CDR.Active and enemy.Parent ~= nil
        end)
    end)
    CDR.ensureStandOut(LP.Character)
    pcall(function() CDR.enablePilot() end)

    while CDR.Active and enemy.Parent and tick() - started < 45 do
        char = LP.Character
        root = char and char:FindFirstChild("HumanoidRootPart")
        enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
        local health = enemy:FindFirstChild("Health")
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        if not root or not enemyRoot then break end
        if health and tonumber(health.Value) and health.Value <= 0 then break end
        if hum and hum.Health <= 0 then break end

        CDR.stickToRoot(enemyRoot, 0.06)

        local remote = char:FindFirstChild("RemoteEvent")
        if remote then
            pcall(function() remote:FireServer("Attack", "m1") end)
            pcall(function()
                for _, keyName in ipairs(getgenv().AutoUseStandSkillKeys or {"E", "R"}) do
                    local key = Enum.KeyCode[keyName]
                    if key then remote:FireServer("InputBegan", { Input = key }) end
                end
            end)
        end
        task.wait(0.08)
    end
    State.NoClip = false
    local health = enemy:FindFirstChild("Health")
    local hum = enemy:FindFirstChildOfClass("Humanoid")
    return (health and tonumber(health.Value) and health.Value <= 0)
        or (hum and hum.Health <= 0)
        or not enemy.Parent
end

function CDR.talkSuno()
    CDR.setStatus("Going to Merchant's Keep (Suno)...")
    Move.goToCF(CFrame.new(CDR_MERCHANT_KEEP + Vector3.new(0, 3, 0)), Config.Teleport.Mode)

    local dialogues = workspace:FindFirstChild("Dialogues")
    local suno = nil
    if dialogues then
        for _, name in ipairs({"Suno", "Arrowsmith", "Suno the Arrowsmith", "Arrow Smith"}) do
            suno = dialogues:FindFirstChild(name) or dialogues:FindFirstChild(name, true)
            if suno then break end
        end
        if not suno then
            for _, child in ipairs(dialogues:GetChildren()) do
                local n = string.lower(child.Name)
                if string.find(n, "suno", 1, true) or string.find(n, "arrowsmith", 1, true) or string.find(n, "arrow smith", 1, true) then
                    suno = child
                    break
                end
            end
        end
    end

    if not suno then
        CDR.setStatus("Suno / Arrowsmith not found nearby. Stand closer and retry.")
        return false
    end

    local part = suno:IsA("BasePart") and suno or suno:FindFirstChildWhichIsA("BasePart", true)
    if part then
        Move.goToCF(CFrame.new(part.Position + Vector3.new(0, 3, 3)), Config.Teleport.Mode)
    end

    local character = LP.Character
    local remote = character and character:FindFirstChild("RemoteEvent")
    local dialogueFolder = ReplicatedStorage:FindFirstChild("Dialogue")
    local dialogueNameObj = suno:FindFirstChild("Dialogue")
    local dialogueName = dialogueNameObj and tostring(dialogueNameObj.Value or "") or suno.Name
    local template = dialogueFolder and (dialogueFolder:FindFirstChild(dialogueName) or dialogueFolder:FindFirstChild(suno.Name))

    if remote and template then
        pcall(function() remote:FireServer("PromptTriggered", template) end)
    elseif remote then
        pcall(function()
            remote:FireServer("DialogueInteracted", { DialogueName = dialogueName, Speaker = suno.Name })
        end)
    end

    local gui = Gui.waitDialogue(4)
    if not gui then
        CDR.setStatus("Could not open Suno dialogue.")
        return false
    end

    -- Prefer evolve / quest options
    local clicked = false
    for _, optionName in ipairs({"Option1", "Option2", "Option3", "Option4"}) do
        local btn = Gui.option(gui, optionName)
        if btn and Gui.isVisible(btn) then
            local text = string.lower(tostring(btn.Text or ""))
            for _, child in ipairs(btn:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    text = text .. " " .. string.lower(tostring(child.Text or ""))
                end
            end
            if text:find("evolve", 1, true) or text:find("quest", 1, true)
                or text:find("crazy", 1, true) or text:find("requiem", 1, true)
                or text:find("stand", 1, true) or text:find("yes", 1, true)
                or optionName == "Option1" then
                if Gui.click(btn) then
                    clicked = true
                    task.wait(0.25)
                end
            end
        end
    end
    if not clicked then
        Gui.waitAndClickOption("Option1", 3)
    end
    task.wait(0.3)
    pcall(function() Gui.advanceUntilClosed(4) end)
    CDR.setStatus("Suno dialogue finished. Continue the quest steps.")
    return true
end

function CDR.loopCriminals()
    CDR.Kills = 0
    while CDR.Active and CDR.Mode == "Criminals" do
        if not CDR.hasCrazyDiamond() then
            CDR.setStatus("Equip Crazy Diamond (or CDR base). Waiting...")
            task.wait(1)
            continue
        end
        CDR.setStatus(string.format("Criminal farm %d/%d — looking for targets...", CDR.Kills, CDR.TargetKills))
        local enemy = CDR.findEnemyByNames(CDR_CRIMINALS)
        if enemy then
            CDR.setStatus(string.format("Fighting %s (%d/%d)", enemy.Name, CDR.Kills, CDR.TargetKills))
            if CDR.killTarget(enemy) then
                CDR.Kills += 1
                CDR.setStatus(string.format("Kill %d/%d", CDR.Kills, CDR.TargetKills))
            end
        else
            -- wander near Merchant's Keep park area
            Move.goToCF(CFrame.new(CDR_MERCHANT_KEEP + Vector3.new(math.random(-40, 40), 3, math.random(-40, 40))), Config.Teleport.Mode)
            task.wait(0.6)
        end
        if CDR.Kills >= CDR.TargetKills then
            CDR.setStatus("Criminal step done (" .. tostring(CDR.TargetKills) .. "). Talk to Suno for the next quest.")
            cdrNotify("Criminal kills finished. Talk to Suno.", "Success", 6)
            break
        end
        task.wait(0.1)
    end
end

function CDR.loopKira()
    while CDR.Active and CDR.Mode == "Kira" do
        if not CDR.hasCrazyDiamond() then
            CDR.setStatus("Equip Crazy Diamond. Waiting...")
            task.wait(1)
            continue
        end
        CDR.setStatus("Looking for Yoshikage Kira...")
        local kira = CDR.findEnemyByNames(CDR_KIRA_NAMES)
        if kira then
            CDR.setStatus("Fighting " .. kira.Name .. "...")
            if CDR.killTarget(kira) then
                CDR.setStatus("Kira defeated. Talk to Suno, then use Requiem Arrow.")
                cdrNotify("Yoshikage Kira defeated!", "Success", 7)
                break
            end
        else
            Move.goToCF(CFrame.new(CDR_MERCHANT_KEEP + Vector3.new(0, 3, 0)), Config.Teleport.Mode)
            task.wait(1.2)
        end
        task.wait(0.15)
    end
end

function CDR.getPlayerStand(plr)
    if not plr then return "" end
    local stats = plr:FindFirstChild("PlayerStats")
    local stand = stats and stats:FindFirstChild("Stand")
    if stand then return tostring(stand.Value or "") end
    local _, standName = Utils.playerInfo(plr)
    return tostring(standName or "")
end

CDR.AnyStand = false
CDR.CustomStands = {}

function CDR.isVillainStand(standName)
    local lower = string.lower(tostring(standName or ""))
    if CDR.AnyStand then return true end
    if lower == "" or lower == "none" or lower == "?" then return false end
    for _, custom in ipairs(CDR.CustomStands) do
        if custom ~= "" and string.find(lower, custom, 1, true) then return true end
    end
    for _, villain in ipairs(CDR_VILLAIN_STANDS) do
        if lower == villain or string.find(lower, villain, 1, true) then
            return true
        end
    end
    return false
end

function CDR.scanSummary()
    local total, withStand, names = 0, 0, {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            total += 1
            local stand = CDR.getPlayerStand(plr)
            local lower = string.lower(stand)
            if lower ~= "" and lower ~= "none" and lower ~= "?" then
                withStand += 1
                if #names < 4 then table.insert(names, stand) end
            end
        end
    end
    return string.format("%d players, %d with stand%s", total, withStand,
        #names > 0 and (" (" .. table.concat(names, ", ") .. ")") or "")
end

function CDR.ensureStandOut(char)
    if not char or char:FindFirstChild("StandMorph") then return end
    local rf = char:FindFirstChild("RemoteFunction")
    if rf then
        pcall(function() rf:InvokeServer("ToggleStand", "Toggle") end)
        for _ = 1, 10 do
            if char:FindFirstChild("StandMorph") then break end
            task.wait(0.1)
        end
    end
end

function CDR.enablePilot()
    local pilot = _G.MethionStandPilotRuntime
    if type(pilot) ~= "table" then return false end
    if pilot.Enabled then return true end
    if type(pilot.SetEnabled) == "function" then
        local ok = pcall(function() pilot.SetEnabled(true) end)
        task.wait(0.12)
        return ok and pilot.Enabled == true
    end
    return false
end

function CDR.forceNoclip(character)
    character = character or LP.Character
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part.CanCollide = false end)
        end
    end
    local stand = character:FindFirstChild("StandMorph")
    if stand then
        for _, part in ipairs(stand:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = false end)
            end
        end
    end
end

function CDR.goalBehind(targetRoot, distance, height)
    -- Stand almost on top of the person
    distance = tonumber(distance) or 0.35
    height = tonumber(height) or 0.35
    return targetRoot.CFrame * CFrame.new(0, height, distance)
end

function CDR.flyOrSnapTo(goal, keepGoing)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or typeof(goal) ~= "CFrame" then return false end
    State.NoClip = true
    CDR.forceNoclip(char)
    local dist = (root.Position - goal.Position).Magnitude
    if dist > 20 and Move and type(Move.flyCF) == "function" then
        local speed = math.clamp(tonumber(Config.TweenSpeed) or 300, 10, 3000)
        return Move.flyCF(goal, speed, keepGoing) == true
    end
    root.CFrame = goal
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

function CDR.stickToRoot(targetRoot, dt)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not char or not root or not targetRoot or not targetRoot.Parent then return false end

    State.NoClip = true
    CDR.forceNoclip(char)

    local goal = CDR.goalBehind(targetRoot, 0.35, 0.35)
    local dist = (root.Position - goal.Position).Magnitude
    dt = tonumber(dt) or 0.016
    local speed = math.clamp(tonumber(Config.TweenSpeed) or 300, 10, 3000)
    local alpha
    if dist > 90 then
        alpha = math.clamp(speed * dt / dist, 0.1, 0.5)
    elseif dist > 20 then
        alpha = math.clamp(speed * dt / dist, 0.18, 0.75)
    else
        alpha = 1
    end

    local pilot = _G.MethionStandPilotRuntime
    local pilotOn = type(pilot) == "table" and pilot.Enabled == true
    local stand = char:FindFirstChild("StandMorph")
    local standRoot = stand and (stand.PrimaryPart or stand:FindFirstChild("HumanoidRootPart"))

    local bodyGoal = pilotOn and (goal - Vector3.new(0, 35, 0)) or goal
    root.CFrame = root.CFrame:Lerp(CFrame.lookAt(bodyGoal.Position, targetRoot.Position), alpha)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    if standRoot and standRoot.Parent then
        local standCF = CFrame.lookAt(goal.Position, targetRoot.Position)
        standRoot.CFrame = standRoot.CFrame:Lerp(standCF, math.max(alpha, 0.4))
        standRoot.AssemblyLinearVelocity = Vector3.zero
        standRoot.AssemblyAngularVelocity = Vector3.zero
        pcall(function()
            if stand.PrimaryPart then stand:PivotTo(standRoot.CFrame) end
        end)
    end
    return true
end

function CDR.findVillainPlayer()
    local best, bestDist = nil, math.huge
    local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not CDR.KilledVillains[plr.UserId] then
            local standName = CDR.getPlayerStand(plr)
            if CDR.isVillainStand(standName) then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Head"))
                if not char then CDR.ScanNoChar = (CDR.ScanNoChar or 0) + 1
                elseif not root then CDR.ScanNoRoot = (CDR.ScanNoRoot or 0) + 1 end
                if char and root and hum and hum.Health > 0 then
                    local dist = myRoot and (root.Position - myRoot.Position).Magnitude or 0
                    if dist < bestDist then
                        bestDist = dist
                        best = plr
                    end
                end
            end
        end
    end
    return best
end

function CDR.killPlayer(plr)
    if not plr or not plr.Parent then return false end
    local started = tick()
    State.NoClip = true
    CDR.forceNoclip()

    -- Fly in + enable pilot once at the start of the engage
    do
        local targetChar = plr.Character
        local targetRoot = targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar.PrimaryPart)
        if targetRoot then
            local goal = CDR.goalBehind(targetRoot, 0.35, 0.35)
            CDR.flyOrSnapTo(goal, function()
                return CDR.Active and plr.Parent ~= nil
            end)
        end
        CDR.ensureStandOut(LP.Character)
        pcall(function() CDR.enablePilot() end)
    end

    while CDR.Active and plr.Parent and tick() - started < 55 do
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local targetChar = plr.Character
        local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
        local targetRoot = targetChar and (targetChar:FindFirstChild("HumanoidRootPart") or targetChar.PrimaryPart or targetChar:FindFirstChild("Head"))
        if not root then break end
        if targetChar and not targetRoot then
            task.wait(0.2)
            if tick() - started > 8 then break end
            continue
        end
        if not targetChar or not targetRoot or not targetHum or targetHum.Health <= 0 then
            State.NoClip = false
            return true
        end

        -- Continuous fly-stick to the player (same mechanic as Player Target attach)
        CDR.stickToRoot(targetRoot, 0.07)
        CDR.ensureStandOut(char)

        local remote = char:FindFirstChild("RemoteEvent")
        if remote and not targetChar:FindFirstChildOfClass("ForceField") then
            pcall(function() remote:FireServer("Attack", "m1") end)
            pcall(function()
                for _, keyName in ipairs(getgenv().AutoUseStandSkillKeys or {"E", "R", "T"}) do
                    local key = Enum.KeyCode[keyName]
                    if key then remote:FireServer("InputBegan", { Input = key }) end
                end
            end)
        end
        task.wait(0.05)
    end
    State.NoClip = false
    local targetChar = plr.Character
    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    return not plr.Parent or not targetChar or not targetHum or targetHum.Health <= 0
end

function CDR.queueResumeAfterHop()
    local queueFunction = MethionSH_Env.queue_on_teleport or MethionSH_Env.queueonteleport
    if type(queueFunction) ~= "function" and type(MethionSH_Env.syn) == "table" then
        queueFunction = MethionSH_Env.syn.queue_on_teleport
    end
    if type(queueFunction) ~= "function" then return false end

    local kills = tonumber(CDR.VillainKills) or 0
    local target = tonumber(CDR.VillainTarget) or 25
    local url = RELOAD_SCRIPT_RAW_URL
    local source = table.concat({
        "repeat task.wait() until game:IsLoaded()",
        "local env = type(getgenv) == \"function\" and getgenv() or _G",
        "env.__MethionSHCDRVillainResume = {kills=" .. tostring(kills) .. ",target=" .. tostring(target) .. ",hop=true}",
        "local ok, err = pcall(function()",
        "    local src = game:HttpGet(" .. string.format("%q", tostring(url)) .. ")",
        "    loadstring(src)()",
        "end)",
        "if not ok then warn('[CDR hop resume] '..tostring(err)) end",
    }, "\n")
    local ok = pcall(queueFunction, source)
    return ok == true
end

function CDR.serverHop()
    if CDR.HopBusy then return false end
    if tick() - (CDR.LastHop or 0) < 5 then return false end
    CDR.HopBusy = true
    CDR.LastHop = tick()
    CDR.setStatus("No villains — server hopping...")
    cdrNotify("Server hopping to find villain-stand players...", "Info", 4)

    pcall(function() CDR.queueResumeAfterHop() end)

    local placeId = game.PlaceId
    local jobId = game.JobId
    local candidates = {}

    local ok, response = pcall(function()
        return game:HttpGet(
            "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Desc&limit=100"
        )
    end)
    if ok and type(response) == "string" then
        local decodeOk, payload = pcall(function()
            return HttpService:JSONDecode(response)
        end)
        if decodeOk and type(payload) == "table" and type(payload.data) == "table" then
            for _, server in ipairs(payload.data) do
                local id = server.id
                local playing = tonumber(server.playing) or 0
                local maximum = tonumber(server.maxPlayers) or 0
                if type(id) == "string" and id ~= "" and id ~= jobId and maximum > 0 and playing > 0 and playing < maximum then
                    table.insert(candidates, {id = id, playing = playing})
                end
            end
            table.sort(candidates, function(a, b)
                return a.playing > b.playing -- prefer fuller servers (more players)
            end)
        end
    end

    local hopped = false
    for _, server in ipairs(candidates) do
        local okHop = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, server.id, LP)
        end)
        if okHop then
            hopped = true
            break
        end
        task.wait(0.35)
    end

    if not hopped then
        pcall(function()
            TeleportService:Teleport(placeId, LP)
        end)
    end

    task.delay(8, function()
        CDR.HopBusy = false
    end)
    return true
end

function CDR.loopVillains()
    -- Resume progress after server hop if queued
    local resume = MethionSH_Env.__MethionSHCDRVillainResume
    if type(resume) == "table" then
        CDR.VillainKills = tonumber(resume.kills) or 0
        CDR.VillainTarget = tonumber(resume.target) or CDR.VillainTarget
        MethionSH_Env.__MethionSHCDRVillainResume = nil
        CDR.setStatus(string.format("Resumed after hop (%d/%d)", CDR.VillainKills, CDR.VillainTarget))
    else
        CDR.VillainKills = 0
    end
    table.clear(CDR.KilledVillains)

    local noTargetSince = tick()
    while CDR.Active and CDR.Mode == "Villains" do
        CDR.ScanNoChar, CDR.ScanNoRoot = 0, 0
        if not CDR.hasCrazyDiamond() and not CDR.WarnedNoCD then
            CDR.WarnedNoCD = true
            cdrNotify("Crazy Diamond is not detected as your stand. Farming anyway.", "Warning", 4)
        end

        CDR.setStatus(string.format(
            "Villain farm %d/%d — scanning players...",
            CDR.VillainKills,
            CDR.VillainTarget
        ))

        local target = CDR.findVillainPlayer()
        if target then
            noTargetSince = tick()
            local standName = CDR.getPlayerStand(target)
            CDR.setStatus(string.format(
                "Fighting @%s [%s] (%d/%d)",
                target.Name,
                standName,
                CDR.VillainKills,
                CDR.VillainTarget
            ))
            if CDR.killPlayer(target) then
                CDR.KilledVillains[target.UserId] = true
                CDR.VillainKills += 1
                CDR.setStatus(string.format("Villain kill %d/%d", CDR.VillainKills, CDR.VillainTarget))
                cdrNotify(string.format("Villain down: %s (%s)", target.Name, standName), "Success", 3)
            else
                CDR.KilledVillains[target.UserId] = true
                task.delay(20, function()
                    CDR.KilledVillains[target.UserId] = nil
                end)
            end
        else
            local waited = tick() - noTargetSince
            CDR.setStatus(string.format(
                "No villains (%d/%d). %s%s. Hop in %.0fs...",
                CDR.VillainKills,
                CDR.VillainTarget,
                CDR.scanSummary(),
                ((CDR.ScanNoChar or 0) + (CDR.ScanNoRoot or 0)) > 0
                    and string.format(" [not loaded: %d]", (CDR.ScanNoChar or 0) + (CDR.ScanNoRoot or 0)) or "",
                math.max(0, (CDR.HopWaitSeconds or 8) - waited)
            ))
            if CDR.AutoHop and waited >= (CDR.HopWaitSeconds or 8) then
                CDR.serverHop()
                -- If hop fails, wait before retrying
                noTargetSince = tick()
                task.wait(2)
            else
                task.wait(1)
            end
        end

        if CDR.VillainKills >= CDR.VillainTarget then
            CDR.setStatus("Villain step done (" .. tostring(CDR.VillainTarget) .. "). Talk to Suno.")
            cdrNotify("Villain-stand kills finished.", "Success", 7)
            break
        end
        task.wait(0.12)
    end
end

CDR.Busy = false
CDR.Switching = false

function CDR.start(mode)
    if CDR.Active then return end
    CDR.Active = true
    CDR.Mode = mode or "Criminals"
    CDR.Session += 1
    local session = CDR.Session
    task.spawn(function()
        CDR.Busy = true
        local ok, err = pcall(function()
            if CDR.Mode == "Suno" then
                CDR.talkSuno()
            elseif CDR.Mode == "Kira" then
                CDR.loopKira()
            elseif CDR.Mode == "Villains" then
                CDR.loopVillains()
            elseif CDR.Mode == "Heal" then
                CDR.loopHeal()
            else
                CDR.loopCriminals()
            end
        end)
        if not ok then
            warn("[CDR Quest] " .. tostring(err))
            CDR.setStatus("Error: " .. tostring(err))
            cdrNotify("CDR helper error: " .. tostring(err), "Warning", 6)
        end
        if CDR.Session == session then
            CDR.Active = false
        end
        CDR.Busy = false
    end)
end
function CDR.switchTo(mode)
    if CDR.Active then
        CDR.Active = false
        local t = tick()
        while CDR.Busy and tick() - t < 5 do task.wait(0.1) end
    end
    CDR.start(mode)
end

function CDR.useRequiemArrow()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = LP:FindFirstChild("Backpack")
    local tool = (char and char:FindFirstChild("Requiem Arrow"))
        or (backpack and backpack:FindFirstChild("Requiem Arrow"))
    if not hum or not tool then return false, "Requiem Arrow not in inventory" end
    pcall(function() hum:EquipTool(tool) end)
    local equipped
    for _ = 1, 20 do
        equipped = char:FindFirstChild("Requiem Arrow")
        if equipped then break end
        task.wait(0.05)
    end
    if not equipped then return false, "Could not equip Requiem Arrow" end
    task.wait(0.2)
    pcall(function() equipped:Activate() end)
    local gui = Gui.waitDialogue(4)
    if gui then Gui.waitAndClickOption("Option1", 5) end
    local deadline = tick() + 14
    while tick() < deadline do
        local stand = string.lower(tostring(Utils.stat(LP, "Stand") or ""))
        if string.find(stand, "requiem", 1, true) then return true end
        task.wait(0.25)
    end
    return false, "Stand did not change"
end

