local LowGfx = {
    RenderingDisabled = false,
}

function LowGfx.set3dRendering(enabled)
    -- enabled=true means 3D rendering ON; false = disable 3D rendering (FPS boost while AFK farm)
    local want3d = enabled == true
    LowGfx.RenderingDisabled = not want3d
    local ok = false
    pcall(function()
        if type(RunService.Set3dRenderingEnabled) == "function" then
            RunService:Set3dRenderingEnabled(want3d)
            ok = true
        end
    end)
    if not ok then
        pcall(function()
            local s = settings()
            if s and s.Rendering then
                if want3d then
                    s.Rendering.QualityLevel = Enum.QualityLevel.Automatic
                else
                    s.Rendering.QualityLevel = Enum.QualityLevel.Level01
                    pcall(function() s.Rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01 end)
                    pcall(function() s.Rendering.EagerBulkExecution = true end)
                end
            end
        end)
    end
    return LowGfx.RenderingDisabled
end

function LowGfx.apply(opts)
    opts = type(opts) == "table" and opts or {}
    local disable3d = opts.Disable3D == true or opts.disable3d == true

    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.Brightness = 1
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        Lighting.FogStart = 0
        Lighting.FogEnd = 1e9
        Lighting.Technology = Enum.Technology.Compatibility
    end)
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") then v.Enabled = false end
    end
    pcall(function()
        local t = workspace:FindFirstChildOfClass("Terrain")
        if t then
            t.WaterTransparency = 1
            pcall(function() t.Decoration = false end)
        end
    end)
    pcall(function()
        local s = settings()
        if s and s.Rendering then
            s.Rendering.QualityLevel = Enum.QualityLevel.Level01
        end
    end)
    task.spawn(function()
        local n = 0
        for _, obj in ipairs(workspace:GetDescendants()) do
            pcall(function()
                if obj:IsA("BasePart") then
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                    obj.CastShadow = false
                elseif obj:IsA("Decal") or obj:IsA("Texture") then
                    obj.Transparency = 1
                elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
                    obj.Enabled = false
                end
            end)
            n = n + 1
            if n % 250 == 0 then task.wait() end
        end
    end)
    pcall(function()
        if setfpscap then setfpscap(240) end
    end)

    if disable3d then
        LowGfx.set3dRendering(false)
    end

    State.LowGraphics = true
    State.Optimization = true
end

function LowGfx.restore3d()
    LowGfx.set3dRendering(true)
    State.Optimization = false
end

local Rejoin = {}
local rejoinConn = nil
local rejoinBusy = false

local function queueReloadAndRejoin()
    local url = RELOAD_SCRIPT_RAW_URL
    if type(url) ~= "string" or url == "" or not url:match("^https?://") then return false end
    local queueFunction = MethionSH_Env.queue_on_teleport or MethionSH_Env.queueonteleport
    if type(queueFunction) ~= "function" and type(MethionSH_Env.syn) == "table" then
        queueFunction = MethionSH_Env.syn.queue_on_teleport
    end
    if type(queueFunction) ~= "function" then return false end

    local mode = Config.FarmTeleportMode == "tween" and "tween" or "instant"
    local filterJson = HttpService:JSONEncode(Config.FarmOnlyItems or {})
    local autoStart = State.Farm == true
    local queueSource = table.concat({
        "repeat task.wait() until game:IsLoaded()",
        "local env = type(getgenv) == \"function\" and getgenv() or _G",
        "local http = game:GetService(\"HttpService\")",
        "env.__MethionSHFarmTeleportMode = " .. string.format("%q", mode),
        "local filterOk, filter = pcall(function() return http:JSONDecode(" .. string.format("%q", filterJson) .. ") end)",
        "if filterOk and type(filter) == \"table\" then env.__MethionSHFarmOnlyItems = filter end",
        "env.__MethionSHReloadOnKick = " .. tostring(Config.AutoRejoinEnabled == true),
        "env.__MethionSHAutoStart = " .. tostring(autoStart),
        "local Players = game:GetService(\"Players\")",
        "local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")",
        "local Lighting = game:GetService(\"Lighting\")",
        "local TeleportService = game:GetService(\"TeleportService\")",
        "local player = Players.LocalPlayer",
        "local function enterGame()",
        "    local playerGui = player:WaitForChild(\"PlayerGui\")",
        "    pcall(function() if not playerGui:FindFirstChild(\"HUD\") then local objects = ReplicatedStorage:FindFirstChild(\"Objects\"); local template = objects and objects:FindFirstChild(\"HUD\"); if template then template:Clone().Parent = playerGui end end end)",
        "    local character = player.Character or player.CharacterAdded:Wait()",
        "    local remote = character:WaitForChild(\"RemoteEvent\", 15)",
        "    if remote and remote:IsA(\"RemoteEvent\") then remote:FireServer(\"PressedPlay\") end",
        "    for _, name in ipairs({\"LoadingScreen1\", \"LoadingScreen\"}) do local screen = playerGui:FindFirstChild(name); if screen then screen:Destroy() end end",
        "    player:SetAttribute(\"LOADED\", \"Skip\")",
        "    local dof = Lighting:FindFirstChild(\"DepthOfField\"); if dof then dof:Destroy() end",
        "    local loading = workspace:FindFirstChild(\"LoadingScreen\"); local song = loading and loading:FindFirstChild(\"Song\"); if song then song:Destroy() end",
        "end",
        "task.spawn(function() while true do pcall(enterGame); task.wait(3) end end)",
        "local deadline = os.clock() + 10",
        "local entered = false",
        "repeat",
        "    task.wait(0.1)",
        "    local character = player.Character",
        "    local humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")",
        "    local root = character and character:FindFirstChild(\"HumanoidRootPart\")",
        "    entered = character ~= nil and character.Parent ~= nil and humanoid ~= nil and humanoid.Health > 0 and root ~= nil and player:GetAttribute(\"LOADED\") == \"Skip\"",
        "until entered or os.clock() >= deadline",
        "if not entered then",
        "    local queueFn = env.queue_on_teleport or env.queueonteleport",
        "    if type(queueFn) ~= \"function\" and type(env.syn) == \"table\" then queueFn = env.syn.queue_on_teleport end",
        "    local retrySource = env.__MethionSHRecoverySource",
        "    if type(queueFn) == \"function\" and type(retrySource) == \"string\" then pcall(queueFn, retrySource) end",
        "    local targetId = nil",
        "    local ok, response = pcall(function() return game:HttpGet(\"https://games.roblox.com/v1/games/\" .. tostring(game.PlaceId) .. \"/servers/Public?sortOrder=Asc&limit=100\") end)",
        "    if ok and type(response) == \"string\" then",
        "        local decodedOk, payload = pcall(function() return http:JSONDecode(response) end)",
        "        if decodedOk and type(payload) == \"table\" and type(payload.data) == \"table\" then",
        "            local candidates = {}",
        "            for _, server in ipairs(payload.data) do local id = server.id; local playing = tonumber(server.playing) or math.huge; local maximum = tonumber(server.maxPlayers) or 0; if type(id) == \"string\" and id ~= \"\" and id ~= game.JobId and maximum > 0 and playing < maximum then table.insert(candidates, {id = id, playing = playing}) end end",
        "            table.sort(candidates, function(a, b) return a.playing < b.playing end)",
        "            if candidates[1] then targetId = candidates[1].id end",
        "        end",
        "    end",
        "    local hopOk = false",
        "    if targetId then hopOk = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, targetId, player) end) end",
        "    if not hopOk then pcall(function() TeleportService:Teleport(game.PlaceId, player) end) end",
        "    return",
        "end",
        "task.wait(0.5)",
        "local source = game:HttpGet(" .. string.format("%q", url) .. ")",
        "assert(type(source) == 'string' and #source > 0, 'Methion source is empty')",
        "local chunk, err = loadstring(source)",
        "assert(type(chunk) == 'function', tostring(err or 'MethionSH compile failed'))",
        "chunk()",
        "",
    }, "\n")
    MethionSH_Env.__MethionSHRecoverySource = queueSource
    local ok = pcall(queueFunction, queueSource)
    if not ok then return false end
    local teleported = pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
    return teleported
end

function Rejoin.start()
    if rejoinConn then return end
    pcall(function()
        local GuiService = game:GetService("GuiService")
        rejoinConn = GuiService.ErrorMessageChanged:Connect(function(message)
            if not Config.AutoRejoinEnabled or not message or message == "" or rejoinBusy then return end
            task.spawn(function()
                if rejoinBusy then return end
                rejoinBusy = true
                task.wait(0.35)
                local ok, reloading = pcall(queueReloadAndRejoin)
                if not ok or not reloading then
                    pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
                end
            end)
        end)
    end)
end

function Rejoin.stop()
    if rejoinConn then
        rejoinConn:Disconnect()
        rejoinConn = nil
    end
end

-- Full script reload on fatal errors (same server, no teleport).
local ScriptRecovery = {
    Busy = false,
    LastReload = 0,
    MinInterval = 8,
    MaxGuiReloads = 3,
}

local function scriptRecoveryCountGuiReloads()
    return tonumber(MethionSH_Env.__MethionSHGuiReloadCount) or 0
end

local function scriptRecoveryBumpGuiReloads()
    local n = scriptRecoveryCountGuiReloads() + 1
    MethionSH_Env.__MethionSHGuiReloadCount = n
    return n
end

local function scriptRecoveryResetGuiReloads()
    MethionSH_Env.__MethionSHGuiReloadCount = 0
end

function ScriptRecovery.reload(reason)
    if ScriptRecovery.Busy then return false end
    local now = tick()
    if now - ScriptRecovery.LastReload < ScriptRecovery.MinInterval then return false end
    ScriptRecovery.Busy = true
    ScriptRecovery.LastReload = now

    local reasonText = tostring(reason or "unknown")
    warn("[Methion] Reloading script because of error: " .. reasonText)
    pcall(function()
        AirflowCompat:Notify({
            Title = "Methion",
            Content = "Error detected — reloading script...",
            Type = "Warning",
            Duration = 4,
        })
    end)

    task.spawn(function()
        local ok, err = pcall(function()
            -- Stop noisy loops before reload
            State.Farm = false
            State.StandFarm = false
            State.HalloweenCandyFarm = false
            State.NoClip = false

            pcall(function()
                if CompatWindow and type(CompatWindow.Destroy) == "function" then
                    CompatWindow:Destroy()
                end
            end)

            local source = nil

            -- 1) Explicit recovery source (queued rejoin / pre-seeded)
            if type(MethionSH_Env.__MethionSHRecoverySource) == "string"
                and #MethionSH_Env.__MethionSHRecoverySource > 100 then
                source = MethionSH_Env.__MethionSHRecoverySource
            end

            -- 2) Local file (keeps custom edits like GUI auto-restart)
            if type(source) ~= "string" or #source < 100 then
                local readFn = readfile or (type(syn) == "table" and syn.read_file) or nil
                if type(readFn) == "function" then
                    for _, fileName in ipairs({
                        "Methion_V2_FastSkip.lua",
                        "Methion_V2.lua",
                        "Methion.V2.lua",
                        "Methion.lua",
                    }) do
                        local okRead, content = pcall(readFn, fileName)
                        if okRead and type(content) == "string" and #content > 100 then
                            source = content
                            break
                        end
                    end
                end
            end

            -- 3) Remote URL fallback
            if type(source) ~= "string" or #source < 100 then
                local url = RELOAD_SCRIPT_RAW_URL
                if type(url) == "string" and url:match("^https?://") then
                    local okGet, body = pcall(function()
                        return game:HttpGet(url)
                    end)
                    if okGet and type(body) == "string" and #body > 100 then
                        source = body
                    end
                end
            end

            assert(type(source) == "string" and #source > 100, "Could not download script source")

            MethionSH_Env.__MethionSHAutoStart = State.Farm == true
            local chunk, compileError = loadstring(source)
            assert(type(chunk) == "function", compileError or "compile failed")
            chunk()
        end)
        if not ok then
            warn("[Methion] Script reload failed: " .. tostring(err))
            ScriptRecovery.Busy = false
        end
    end)
    return true
end

-- Detect whether the Methion / Airflow UI actually mounted under CoreGui.
function ScriptRecovery.isGuiPresent()
    local coreGui = game:GetService("CoreGui")

    local function nameLooksLikeUi(name)
        name = string.lower(tostring(name or ""))
        return name:find("methion", 1, true)
            or name:find("airflow", 1, true)
            or name:find("phantom", 1, true)
            or name:find("flow", 1, true)
            or name:find("window", 1, true)
    end

    local function instanceLooksLive(inst)
        if typeof(inst) ~= "Instance" or not inst.Parent then return false end
        if not inst:IsDescendantOf(coreGui) then return false end
        if inst:IsA("ScreenGui") then
            return inst.Enabled ~= false
        end
        if inst:IsA("GuiObject") then
            return true
        end
        return true
    end

    local window = CompatWindow
    if type(window) == "table" then
        local raw = window.Raw
        if raw ~= nil then
            if typeof(raw) == "Instance" and instanceLooksLive(raw) then
                return true
            end
            if type(raw) == "table" then
                for _, key in ipairs({
                    "ScreenGui", "Gui", "Main", "Window", "Frame", "UI", "Holder",
                    "Root", "Container", "MainFrame", "OpenButton", "Library",
                }) do
                    local ok, obj = pcall(function() return raw[key] end)
                    if ok and instanceLooksLive(obj) then
                        return true
                    end
                end
            end
        end
        for _, key in ipairs({"MainFrame", "Frame", "Window", "ScreenGui", "Gui"}) do
            local ok, obj = pcall(function() return window[key] end)
            if ok and instanceLooksLive(obj) then
                return true
            end
        end
    end

    local okChildren, children = pcall(function() return coreGui:GetChildren() end)
    if okChildren and type(children) == "table" then
        for _, child in ipairs(children) do
            if child:IsA("ScreenGui") and nameLooksLikeUi(child.Name) and child.Enabled ~= false then
                return true
            end
        end
        for _, child in ipairs(children) do
            if child:IsA("ScreenGui") and child.Enabled ~= false then
                local found = false
                pcall(function()
                    for _, desc in ipairs(child:GetDescendants()) do
                        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and type(desc.Text) == "string" then
                            local t = string.lower(desc.Text)
                            if t == "methion" or t:find("methion", 1, true) then
                                found = true
                                break
                            end
                        end
                    end
                end)
                if found then return true end
            end
        end
    end

    return false
end

function ScriptRecovery.ensureGuiOrReload(options)
    options = options or {}
    local waitSeconds = tonumber(options.Wait) or 4
    local reason = tostring(options.Reason or "GUI did not appear")
    local maxAttempts = tonumber(options.MaxAttempts) or ScriptRecovery.MaxGuiReloads

    task.spawn(function()
        local deadline = tick() + math.max(1, waitSeconds)
        while tick() < deadline do
            if ScriptRecovery.isGuiPresent() then
                scriptRecoveryResetGuiReloads()
                return
            end
            task.wait(0.35)
        end

        if ScriptRecovery.isGuiPresent() then
            scriptRecoveryResetGuiReloads()
            return
        end

        local attempt = scriptRecoveryBumpGuiReloads()
        if attempt > maxAttempts then
            warn("[Methion] GUI still missing after " .. tostring(maxAttempts) .. " reloads — stopping auto-restart.")
            pcall(function()
                warn("[Methion] Last reason: " .. reason)
            end)
            return
        end

        warn("[Methion] GUI missing (attempt " .. tostring(attempt) .. "/" .. tostring(maxAttempts) .. "). Reloading...")
        ScriptRecovery.reload(reason .. " (attempt " .. tostring(attempt) .. ")")
    end)
end

local Shop = {}

function Shop.buy(itemName)
    pcall(function()
        local char = LP.Character
        if not char then return end
        local ev = char:FindFirstChild("RemoteEvent")
        if not ev then return end
        ev:FireServer("PurchaseShopItem", {ItemName = itemName})
    end)
end

function Shop.countTool(name)
    local count = 0
    local seen = {}
    local containers = {}
    if LP.Character then table.insert(containers, LP.Character) end
    local backpack = LP:FindFirstChild("Backpack")
    if backpack then table.insert(containers, backpack) end
    for _, container in ipairs(containers) do
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Tool") and obj.Name == name and not seen[obj] then
                seen[obj] = true
                count += 1
            end
        end
    end
    return count
end

function Shop.findTool(name)
    local character = LP.Character
    local tool = character and character:FindFirstChild(name)
    if tool and tool:IsA("Tool") then return tool end
    local backpack = LP:FindFirstChild("Backpack")
    tool = backpack and backpack:FindFirstChild(name)
    if tool and tool:IsA("Tool") then return tool end
    return nil
end

-- Try Jack / Merchant dialogue purchase paths used by some YBA shop NPCs.
function Shop.buyLuckyFromJack()
    local character = LP.Character
    local remote = character and character:FindFirstChild("RemoteEvent")
    if not remote or not remote:IsA("RemoteEvent") then return false end

    local dialogueFolder = ReplicatedStorage:FindFirstChild("Dialogue")
        or ReplicatedStorage:FindFirstChild("NewDialogue")
    if not dialogueFolder then return false end

    local npcNames = {"Jack", "Merchant", "Shop", "Item Shop"}
    local npc = nil
    for _, name in ipairs(npcNames) do
        npc = dialogueFolder:FindFirstChild(name)
        if npc then break end
    end

    -- Always fire the reliable purchase remote first.
    pcall(function()
        remote:FireServer("PurchaseShopItem", {ItemName = Config.LuckyArrowItem or "1x Lucky Arrow"})
    end)

    if not npc then return true end

    -- Open NPC and click through common buy options if a dialogue appears.
    pcall(function()
        remote:FireServer("PromptTriggered", npc)
    end)

    local gui = Gui.waitDialogue(2)
    if not gui then return true end

    -- Prefer options that look like buying / lucky arrow.
    local preferred = {"Option1", "Option2", "Option3", "Option4"}
    for _, optionName in ipairs(preferred) do
        local option = Gui.option(gui, optionName)
        if option and Gui.isVisible(option) then
            local text = ""
            pcall(function()
                text = string.lower(tostring(option.Text or ""))
                for _, d in ipairs(option:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") then
                        text = text .. " " .. string.lower(tostring(d.Text or ""))
                    end
                end
            end)
            if text:find("lucky", 1, true)
                or text:find("arrow", 1, true)
                or text:find("buy", 1, true)
                or text:find("purchase", 1, true)
                or text:find("shop", 1, true)
                or optionName == "Option1" then
                Gui.click(option)
                task.wait(0.25)
                -- Confirm if a second prompt appears.
                pcall(function()
                    Gui.waitAndClickOption("Option1", 1.5)
                end)
                break
            end
        end
    end

    pcall(function()
        if Gui.currentDialogue() then Gui.skipClick() end
    end)
    return true
end

function Shop.redeemLuckyArrow()
    if State.Selling or State.StandFarm then return false end
    local toolName = Config.LuckyArrowToolName or "Lucky Arrow"
    local tool = Shop.findTool(toolName)
    if not tool then return false end

    local character = LP.Character
    local humanoid = character and character:FindFirstChildWhichIsA("Humanoid")
    if not character or not humanoid or humanoid.Health <= 0 then return false end

    pcall(function() humanoid:EquipTool(tool) end)
    local equipped = nil
    for _ = 1, 25 do
        equipped = character:FindFirstChild(toolName)
        if equipped and equipped:IsA("Tool") then break end
        task.wait(0.05)
    end
    if not equipped then return false end

    task.wait(0.15)
    pcall(function() equipped:Activate() end)

    -- Confirm "use arrow" dialogue if it shows.
    local gui = Gui.waitDialogue(3)
    if gui then
        local clicked = false
        pcall(function()
            clicked = Gui.waitAndClickOption("Option1", 4) == true
        end)
        if not clicked then
            for _ = 1, 6 do
                local current = Gui.currentDialogue()
                if not current then break end
                local opt = Gui.option(current, "Option1")
                if opt and Gui.isVisible(opt) and Gui.click(opt) then
                    clicked = true
                    break
                end
                task.wait(0.12)
            end
        end
        task.wait(0.35)
        pcall(function()
            if Gui.currentDialogue() and not Gui.hasVisibleOptions(Gui.currentDialogue()) then
                Gui.skipClick()
            end
        end)
    end
    return true
end

function Shop.autoLucky()
    if Shop._autoLuckyRunning then return end
    Shop._autoLuckyRunning = true
    task.spawn(function()
        local lastBuyAt = 0
        while Config.AutoBuyLucky == true or Config.AutoRedeemLucky == true do
            local ok, err = pcall(function()
                local toolName = Config.LuckyArrowToolName or "Lucky Arrow"
                local maxStock = math.max(1, math.floor(tonumber(Config.LuckyArrowMaxStock) or 9))
                maxStock = math.clamp(maxStock, 1, 9)
                local price = tonumber(Config.LuckyArrowPrice) or 75000
                local owned = Shop.countTool(toolName)
                local boughtThisCycle = false

                -- Buy only — never auto-use in the same cycle after a purchase.
                if Config.AutoBuyLucky == true
                    and owned < maxStock
                    and not State.Selling
                    and not State.StandFarm
                    and Utils.money() >= price then
                    Shop.buyLuckyFromJack()
                    boughtThisCycle = true
                    lastBuyAt = tick()
                    task.wait(1.6)
                    owned = Shop.countTool(toolName)
                end

                -- Redeem only if explicitly enabled, and not right after buying.
                -- Also skip while Auto Farm / selling / stand farm is busy.
                local canRedeem = Config.AutoRedeemLucky == true
                    and owned > 0
                    and not boughtThisCycle
                    and (tick() - lastBuyAt) >= 4.0
                    and not State.Selling
                    and not State.StandFarm
                    and not State.Farm
                    and not State.StandFarmBusy

                if canRedeem then
                    if Shop.redeemLuckyArrow() then
                        task.wait(2.2)
                    else
                        task.wait(0.8)
                    end
                end
            end)
            if not ok then
                warn("[Methion] Auto Lucky failed: " .. tostring(err))
            end
            task.wait(1)
        end
        Shop._autoLuckyRunning = false
    end)
end

local Weather = {ActivePreset = "Original"}

local weatherOrig = {
    ClockTime = Lighting.ClockTime,
    Brightness = Lighting.Brightness,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    FogColor = Lighting.FogColor,
    FogStart = Lighting.FogStart,
    FogEnd = Lighting.FogEnd,
    AtmosphereDensity = Lighting:FindFirstChildOfClass("Atmosphere") and Lighting:FindFirstChildOfClass("Atmosphere").Density or 0.3,
    AtmosphereHaze = Lighting:FindFirstChildOfClass("Atmosphere") and Lighting:FindFirstChildOfClass("Atmosphere").Haze or 0,
}
weatherOrig.AtmosphereInstance = Lighting:FindFirstChildOfClass("Atmosphere")
weatherOrig.AtmosphereColor = weatherOrig.AtmosphereInstance and weatherOrig.AtmosphereInstance.Color or Color3.fromRGB(199, 199, 199)
weatherOrig.AtmosphereDecay = weatherOrig.AtmosphereInstance and weatherOrig.AtmosphereInstance.Decay or Color3.fromRGB(106, 112, 125)
weatherOrig.AtmosphereGlare = weatherOrig.AtmosphereInstance and weatherOrig.AtmosphereInstance.Glare or 0
weatherOrig.AtmosphereOffset = weatherOrig.AtmosphereInstance and weatherOrig.AtmosphereInstance.Offset or 0
weatherOrig.SunRaysInstance = Lighting:FindFirstChild("SunRaysEffect")
weatherOrig.SunRaysEnabled = weatherOrig.SunRaysInstance and weatherOrig.SunRaysInstance.Enabled or false
weatherOrig.SunRaysIntensity = weatherOrig.SunRaysInstance and weatherOrig.SunRaysInstance.Intensity or 0.15
weatherOrig.SunRaysSpread = weatherOrig.SunRaysInstance and weatherOrig.SunRaysInstance.Spread or 1

function Weather.updateStatus()
    pcall(function()
        if UIRefs.weatherPresetLabel then
            UIRefs.weatherPresetLabel:SetDesc(tostring(Weather.ActivePreset or "Original"))
        end
    end)
    pcall(function()
        if UIRefs.weatherTimeLabel then
            UIRefs.weatherTimeLabel:SetDesc(string.format("%.2f", Lighting.ClockTime))
        end
    end)
end

function Weather.sunRays(enabled)
    local sr = Lighting:FindFirstChild("SunRaysEffect")
    if enabled then
        if not sr then
            sr = Instance.new("SunRaysEffect")
            sr.Name = "SunRaysEffect"
            sr.Intensity = 0.15
            sr.Spread = 1
            sr.Parent = Lighting
        end
        sr.Enabled = true
    else
        if sr then sr.Enabled = false end
    end
end

function Weather.setBrightness(value)
    Lighting.Brightness = math.clamp(tonumber(value) or Lighting.Brightness, 0, 4)
    Weather.ActivePreset = "Custom"
    Weather.updateStatus()
end

function Weather.setDensity(value)
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atm then
        atm = Instance.new("Atmosphere")
        atm.Name = "Atmosphere"
        atm.Parent = Lighting
    end
    atm.Density = math.clamp(tonumber(value) or atm.Density, 0, 1)
    Weather.ActivePreset = "Custom"
    Weather.updateStatus()
end

function Weather.setSunRays(enabled)
    Weather.sunRays(enabled == true)
    Weather.ActivePreset = "Custom"
    Weather.updateStatus()
end

function Weather.reset()
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if weatherOrig.AtmosphereInstance then
        if not atm then
            atm = Instance.new("Atmosphere")
            atm.Name = "Atmosphere"
            atm.Parent = Lighting
        end
        atm.Density = weatherOrig.AtmosphereDensity
        atm.Haze = weatherOrig.AtmosphereHaze
        atm.Color = weatherOrig.AtmosphereColor
        atm.Decay = weatherOrig.AtmosphereDecay
        atm.Glare = weatherOrig.AtmosphereGlare
        atm.Offset = weatherOrig.AtmosphereOffset
    elseif atm then
        atm:Destroy()
    end

    Lighting.ClockTime = weatherOrig.ClockTime
    Lighting.Brightness = weatherOrig.Brightness
    Lighting.Ambient = weatherOrig.Ambient
    Lighting.OutdoorAmbient = weatherOrig.OutdoorAmbient
    Lighting.FogColor = weatherOrig.FogColor
    Lighting.FogStart = weatherOrig.FogStart
    Lighting.FogEnd = weatherOrig.FogEnd

    local sr = Lighting:FindFirstChild("SunRaysEffect")
    if weatherOrig.SunRaysInstance then
        if not sr then
            sr = Instance.new("SunRaysEffect")
            sr.Name = "SunRaysEffect"
            sr.Parent = Lighting
        end
        sr.Enabled = weatherOrig.SunRaysEnabled
        sr.Intensity = weatherOrig.SunRaysIntensity
        sr.Spread = weatherOrig.SunRaysSpread
    elseif sr then
        sr:Destroy()
    end

    Weather.ActivePreset = "Original"
    Weather.updateStatus()
end

function Weather.apply(preset)
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if not atm then
        atm = Instance.new("Atmosphere")
        atm.Name = "Atmosphere"
        atm.Parent = Lighting
    end

    Lighting.Brightness = weatherOrig.Brightness
    Lighting.Ambient = weatherOrig.Ambient
    Lighting.OutdoorAmbient = weatherOrig.OutdoorAmbient
    Lighting.FogColor = weatherOrig.FogColor
    Lighting.FogStart = weatherOrig.FogStart
    Lighting.FogEnd = weatherOrig.FogEnd
    atm.Density = weatherOrig.AtmosphereDensity
    atm.Haze = weatherOrig.AtmosphereHaze
    atm.Color = weatherOrig.AtmosphereColor
    atm.Decay = weatherOrig.AtmosphereDecay
    atm.Glare = weatherOrig.AtmosphereGlare
    atm.Offset = weatherOrig.AtmosphereOffset
    Weather.sunRays(false)

    local presetTime = nil
    if preset == "Clear" then
        presetTime = 12
        Lighting.Brightness = 3
        atm.Density = 0.08
        atm.Haze = 0
        atm.Color = Color3.fromRGB(255, 240, 200)
    elseif preset == "Sunny" then
        presetTime = 14
        Lighting.Brightness = 2.5
        atm.Density = 0.12
        atm.Haze = 0
        atm.Color = Color3.fromRGB(255, 246, 225)
        Weather.sunRays(true)
    elseif preset == "Sunset" then
        presetTime = 18.5
        Lighting.Brightness = 1.8
        Lighting.Ambient = Color3.fromRGB(105, 76, 74)
        Lighting.OutdoorAmbient = Color3.fromRGB(135, 91, 72)
        atm.Density = 0.2
        atm.Haze = 0.08
        atm.Color = Color3.fromRGB(255, 183, 126)
    elseif preset == "Overcast" then
        presetTime = 13
        Lighting.Brightness = 1.25
        Lighting.Ambient = Color3.fromRGB(105, 108, 115)
        Lighting.OutdoorAmbient = Color3.fromRGB(125, 128, 135)
        atm.Density = 0.32
        atm.Haze = 0.1
        atm.Color = Color3.fromRGB(195, 201, 210)
    elseif preset == "Night" then
        presetTime = 0
        Lighting.Brightness = 0.5
        Lighting.Ambient = Color3.fromRGB(35, 38, 58)
        Lighting.OutdoorAmbient = Color3.fromRGB(25, 30, 50)
        atm.Density = 0.35
        atm.Haze = 0
        atm.Color = Color3.fromRGB(30, 40, 80)
    elseif preset == "Fog" then
        presetTime = 15
        Lighting.Brightness = 1
        Lighting.FogStart = 0
        Lighting.FogEnd = 450
        Lighting.FogColor = Color3.fromRGB(190, 195, 200)
        atm.Density = 0.45
        atm.Haze = 0.11
        atm.Color = Color3.fromRGB(200, 200, 200)
    else
        return
    end

    if presetTime and not Config.Weather.TimeOfDayEnabled then
        Lighting.ClockTime = presetTime
    end
    Weather.ActivePreset = tostring(preset)
    Weather.updateStatus()
end

local Cam = {
    Active = false,
    Target = nil,
    OriginalCameraType = nil,
    OriginalCameraSubject = nil,
    OriginalCameraCFrame = nil,
    OriginalCameraFocus = nil,
    BeforeCameraStep = "Phantom_PlayerSpectate_BeforeCamera",
    AfterCameraStep = "Phantom_PlayerSpectate_AfterCamera",
}

function Cam.getSubject(targetPlayer)
    local character = targetPlayer and targetPlayer.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    return humanoid or root
end

function Cam.maintainCamera()
    if not Cam.Active then return end
    local cam = workspace.CurrentCamera
    if not cam then return end

    local subject = Cam.getSubject(Cam.Target)
    if not subject then
        local character = LP.Character
        subject = character and character:FindFirstChildOfClass("Humanoid") or nil
    end
    if not subject or not subject.Parent then return end

    pcall(function()
        if cam.CameraType ~= Enum.CameraType.Custom then
            cam.CameraType = Enum.CameraType.Custom
        end
        if cam.CameraSubject ~= subject then
            cam.CameraSubject = subject
        end
    end)
end

function Cam.start(targetPlayer)
    if not targetPlayer or targetPlayer == LP or not targetPlayer.Parent then
        return false
    end

    if Cam.Active then
        Cam.Target = targetPlayer
        Cam.maintainCamera()
        return true
    end

    local cam = workspace.CurrentCamera
    if not cam then return false end

    Cam.OriginalCameraType = cam.CameraType
    Cam.OriginalCameraSubject = cam.CameraSubject
    Cam.OriginalCameraCFrame = cam.CFrame
    Cam.OriginalCameraFocus = cam.Focus
    Cam.Target = targetPlayer
    Cam.Active = true

    pcall(function() RunService:UnbindFromRenderStep(Cam.BeforeCameraStep) end)
    pcall(function() RunService:UnbindFromRenderStep(Cam.AfterCameraStep) end)
    RunService:BindToRenderStep(
        Cam.BeforeCameraStep,
        Enum.RenderPriority.Camera.Value - 1,
        Cam.maintainCamera
    )
    RunService:BindToRenderStep(
        Cam.AfterCameraStep,
        Enum.RenderPriority.Camera.Value + 1,
        Cam.maintainCamera
    )
    Cam.maintainCamera()
    return true
end

function Cam.stop()
    Cam.Active = false
    pcall(function() RunService:UnbindFromRenderStep(Cam.BeforeCameraStep) end)
    pcall(function() RunService:UnbindFromRenderStep(Cam.AfterCameraStep) end)

    local cam = workspace.CurrentCamera
    if cam then
        local subject = Cam.OriginalCameraSubject
        if not subject or not subject.Parent then
            local character = LP.Character
            subject = character and character:FindFirstChildOfClass("Humanoid") or nil
        end
        pcall(function()
            cam.CameraType = Cam.OriginalCameraType or Enum.CameraType.Custom
            if subject and subject.Parent then cam.CameraSubject = subject end
            if Cam.OriginalCameraCFrame then cam.CFrame = Cam.OriginalCameraCFrame end
            if Cam.OriginalCameraFocus then cam.Focus = Cam.OriginalCameraFocus end
        end)
    end

    Cam.Target = nil
    Cam.OriginalCameraType = nil
    Cam.OriginalCameraSubject = nil
    Cam.OriginalCameraCFrame = nil
    Cam.OriginalCameraFocus = nil
end

local Loops = {}

function Loops.noclip()
    RunService.Stepped:Connect(function()
        local want = State.NoClip == true
            or Config.Player.NoClipEnabled == true
            or State.Farm == true
            or State.HalloweenCandyFarm == true
        if not want then return end
        State.NoClip = true
        local char = LP.Character
        if not char then return end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end

-- After death / respawn at safe zone: restore collision and lift above the floor
local function settleCharacterAfterRespawn(char)
    if not char then return end
    State.RespawnSettling = true
    State.NoClip = false

    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 8)
    local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 8)
    if not root then
        State.RespawnSettling = false
        return
    end

    -- Force solid parts
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            p.CanCollide = true
        end
    end

    -- If near safe zone or underground, place safely above ground
    local safe = Config.SafeZone
    if typeof(safe) == "Vector3" then
        local nearSafe = (root.Position - safe).Magnitude < 80
        local tooLow = root.Position.Y < (safe.Y - 2)
        if nearSafe or tooLow then
            root.CFrame = CFrame.new(safe + Vector3.new(0, 6, 0))
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            pcall(function()
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
            end)
        end
    end

    if hum then
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end

    -- Keep solid for a short settle window after respawn
    task.delay(1.25, function()
        if LP.Character ~= char then
            State.RespawnSettling = false
            return
        end
        State.RespawnSettling = false
        -- Restore noclip only if user / farm still wants it
        if Config.Player.NoClipEnabled or State.Farm or State.HalloweenCandyFarm or State.StandFarm then
            State.NoClip = true
        end
    end)
end

do
    local function hookCharacter(char)
        task.defer(function()
            settleCharacterAfterRespawn(char)
        end)
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 8)
        if hum then
            hum.Died:Connect(function()
                State.RespawnSettling = true
                State.NoClip = false
                -- Restore collision on corpse so it does not sink through the map
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                        p.CanCollide = true
                    end
                end
            end)
        end
    end

    if LP.Character then
        hookCharacter(LP.Character)
    end
    LP.CharacterAdded:Connect(hookCharacter)
end

