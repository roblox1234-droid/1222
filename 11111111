		QuestNPCView.Active = false
		QuestNPCView.Target = nil
		QuestNPCView.Camera = nil
		QuestNPCView.CameraType = nil
		QuestNPCView.CameraSubject = nil
		QuestNPCView.CameraCFrame = nil
