local function cdrHealCandidates()
    local list = {}
    local selected = CDR.HealSelected or {}
    local useAll = #selected == 0
    local lookup = {}
    for _, n in ipairs(selected) do lookup[n] = true end
    for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
        if plr ~= LP and (useAll or lookup[plr.Name]) then
            local char = plr.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 and hum.Health < hum.MaxHealth - 1 then
                table.insert(list, {plr = plr, hum = hum, root = root, missing = hum.MaxHealth - hum.Health})
            end
        end
    end
    table.sort(list, function(a, b) return a.missing > b.missing end)
    return list
end

function CDR.loopHeal()
    CDR.HealDone = 0
    local lastHp = {}
    State.NoClip = true
    CDR.forceNoclip()
    pcall(function() CDR.enablePilot() end)
    CDR.setStatus("Heal: waiting for damaged players (0/" .. CDR.HealTarget .. ")")
    while CDR.Active and CDR.HealDone < CDR.HealTarget do
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local remote = char and char:FindFirstChild("RemoteEvent")
        local cands = cdrHealCandidates()
        local target = cands[1]
        if not root or not remote then
            task.wait(0.5)
        elseif not target then
            CDR.setStatus("Heal: no damaged players. Healed " .. math.floor(CDR.HealDone) .. "/" .. CDR.HealTarget)
            task.wait(0.5)
        else
            local plr, hum, troot = target.plr, target.hum, target.root
            CDR.setStatus("Heal: flying to " .. plr.Name .. " (" .. math.floor(CDR.HealDone) .. "/" .. CDR.HealTarget .. ")")
            -- Fly + pilot + stick to the damaged player
            pcall(function()
                local goal = CDR.goalBehind(troot, 0.3, 0.3)
                CDR.flyOrSnapTo(goal, function()
                    return CDR.Active and plr.Parent ~= nil and hum.Parent ~= nil
                end)
            end)
            CDR.ensureStandOut(LP.Character)
            pcall(function() CDR.enablePilot() end)

            local started = tick()
            lastHp[plr] = hum.Health
            while CDR.Active and tick() - started < 25 and plr.Parent
                and hum.Parent and hum.Health > 0 and hum.Health < hum.MaxHealth - 1
                and CDR.HealDone < CDR.HealTarget do
                local myChar = LP.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                local myRemote = myChar and myChar:FindFirstChild("RemoteEvent")
                if not myRoot or not myRemote then break end

                local liveRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                if liveRoot then
                    CDR.stickToRoot(liveRoot, 0.1)
                end

                local key = Enum.KeyCode[CDR.HealKey or "H"]
                if key then
                    pcall(function() myRemote:FireServer("InputBegan", {Input = key}) end)
                end
                task.wait(0.1)
                local now = hum.Health
                if now > (lastHp[plr] or now) then
                    CDR.HealDone += now - lastHp[plr]
                end
                lastHp[plr] = now
            end
        end
        task.wait(0.05)
    end
    State.NoClip = false
    if CDR.HealDone >= CDR.HealTarget then
        CDR.setStatus("Heal: done (" .. math.floor(CDR.HealDone) .. " HP).")
        cdrNotify("Heal step finished (" .. math.floor(CDR.HealDone) .. " HP).", "Success", 7)
    end
end

